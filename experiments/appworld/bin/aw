#!/usr/bin/env python3
"""Run Python code in the current AppWorld task's REPL and print the output.

  aw <<'EOF'
  print(apis.api_docs.show_app_descriptions())
  EOF

Code comes from the arguments or stdin. Variables persist between calls. The environment's URL is read from
$AW_URL or ./.service/base-url.
"""
import json
import os
import sys
import urllib.request

url = os.environ.get("AW_URL")
if not url:
    try:
        url = open(os.path.join(os.getcwd(), ".service", "base-url")).read().strip()
    except OSError:
        sys.exit("aw: no AppWorld environment (set AW_URL or create .service/base-url)")
code = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else sys.stdin.read()
if not code.strip():
    sys.exit("aw: no code given (pass it as an argument or on stdin)")
req = urllib.request.Request(url.rstrip("/") + "/execute", data=json.dumps({"code": code}).encode(), headers={"content-type": "application/json"})
with urllib.request.urlopen(req, timeout=600) as res:
    body = json.load(res)
print(body.get("output", ""))
if body.get("completed"):
    print("[task marked complete]")
