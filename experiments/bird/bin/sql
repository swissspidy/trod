#!/usr/bin/env python3
"""Run read-only SQL against ./db.sqlite and print the rows as tab-separated text.

  sql "SELECT name FROM sqlite_master WHERE type='table'"
  sql --limit 200 "SELECT ..."        (default: first 50 rows; --limit 0 for all)

Code comes from the argument or stdin. The database is opened read-only.
"""
import os
import sqlite3
import sys

args = sys.argv[1:]
limit = 50
if len(args) >= 2 and args[0] == "--limit":
    limit = int(args[1])
    args = args[2:]
query = " ".join(args) if args else sys.stdin.read()
if not query.strip():
    sys.exit('sql: no query given, e.g. sql "SELECT 1"')
db = os.environ.get("BIRD_DB", os.path.join(os.getcwd(), "db.sqlite"))
con = sqlite3.connect(f"file:{os.path.realpath(db)}?mode=ro", uri=True)
try:
    cur = con.execute(query)
except sqlite3.Error as e:
    sys.exit(f"sql error: {e}")
cols = [d[0] for d in cur.description or []]
if cols:
    print("\t".join(cols))
n = 0
for row in cur:
    if limit and n >= limit:
        rest = sum(1 for _ in cur)
        print(f"... ({rest} more rows; use --limit 0 for all)")
        break
    print("\t".join("NULL" if v is None else str(v) for v in row))
    n += 1
