async function checkSyntax(runner, runPath) {
  try {
    if (runner === "mjs") await execFileAsync(process.execPath, ["--check", runPath], { timeout: 1e4 });
    else await execFileAsync("bash", ["-n", runPath], { timeout: 1e4 });
    return void 0;
  } catch (err) {
    const e = err;
    return `syntax error in ${path3.basename(runPath)}: ${(e.stderr || e.message).trim().split("\n").slice(0, 6).join("\n")}`;
  }
}
async function loadToolFolder(dir, source) {
  const folder = path3.basename(dir);
  const tool = { folder, dir, source, hash: hashTool(dir), ok: false, errors: [], warnings: [] };
  const jsonPath = path3.join(dir, "tool.json");
  if (!existsSync3(jsonPath)) {
    tool.errors.push("missing tool.json");
    return tool;
  }
  let raw;
  try {
    raw = JSON.parse(readFileSync2(jsonPath, "utf8"));
  } catch (err) {
    tool.errors.push(`tool.json is not valid JSON: ${err.message}`);
    return tool;
  }
  const { errors, warnings, def } = checkDefinition(raw, folder);
  tool.errors.push(...errors);
  tool.warnings.push(...warnings);
  const hasMjs = existsSync3(path3.join(dir, "run.mjs"));
  const hasSh = existsSync3(path3.join(dir, "run.sh"));
  if (hasMjs && hasSh) tool.errors.push("has both run.mjs and run.sh; keep exactly one");
  else if (!hasMjs && !hasSh) tool.errors.push("missing run.mjs (export default async (input, ctx) => result) or run.sh (input JSON on stdin)");
  else {
    tool.runner = hasMjs ? "mjs" : "sh";
    tool.runPath = path3.join(dir, hasMjs ? "run.mjs" : "run.sh");
    const syntax = await checkSyntax(tool.runner, tool.runPath);
    if (syntax) tool.errors.push(syntax);
  }
  if (def) {
    tool.def = def;
    def.examples?.forEach((ex, i) => {
      for (const msg of validateInput(def, ex.input)) tool.errors.push(`examples[${i}]: ${msg}`);
    });
  }
  tool.ok = tool.errors.length === 0;
  return tool;
}
function deepEqual(a, b) {
  return JSON.stringify(canonical(a)) === JSON.stringify(canonical(b));
}
function canonical(v) {
  if (Array.isArray(v)) return v.map(canonical);
  if (isObject(v)) return Object.fromEntries(Object.keys(v).sort().map((k) => [k, canonical(v[k])]));
  return v;
}
function checkExpectation(expect, text, value) {
  if (!expect) return void 0;
  if (expect.contains !== void 0 && !text.includes(expect.contains))
    return `output does not contain ${JSON.stringify(expect.contains)}`;
  if (expect.matches !== void 0 && !new RegExp(expect.matches).test(text))
    return `output does not match /${expect.matches}/`;
  if ("equals" in expect) {
    const ok = typeof expect.equals === "string" ? text.trim() === expect.equals.trim() || deepEqual(value, expect.equals) : deepEqual(value, expect.equals);
    if (!ok) return `output ${JSON.stringify(value)?.slice(0, 200)} does not equal ${JSON.stringify(expect.equals)?.slice(0, 200)}`;
  }
  return void 0;
}
var META_READER = `
import { pathToFileURL } from 'node:url';
const mod = await import(pathToFileURL(process.argv[1]).href);
if (typeof mod.default !== 'function') throw new Error('the file must default-export a function: export default async (input, ctx) => result');
if (!mod.meta || typeof mod.meta !== 'object') throw new Error('the file must export meta: export const meta = { description, whenToUse, inputSchema }');
process.stdout.write(JSON.stringify(mod.meta));
`;
async function loadToolFile(file, source, opts) {
  const folder = path3.basename(file, ".mjs");
  const tool = { folder, dir: path3.dirname(file), source, hash: hashTool(file), ok: false, errors: [], warnings: [], runner: "mjs", runPath: file };
  const syntax = await checkSyntax("mjs", file);
  if (syntax) {
    tool.errors.push(syntax);
    return tool;
  }
  if (!opts.execAllowed) {
    tool.errors.push("single-file tools (<name>.mjs) are loaded by importing them, which needs TROD_ALLOW_EXEC=1");
    return tool;
  }
  let meta2;
  try {
    const { stdout } = await execFileAsync(process.execPath, ["--input-type=module", "-e", META_READER, file], {
      cwd: path3.dirname(file),
      env: scrubEnv(opts.env ?? process.env),
      timeout: 1e4
    });
    meta2 = JSON.parse(stdout);
  } catch (err) {
    const e = err;
    const lines2 = (e.stderr || e.message).trim().split("\n");
    const msg = lines2.find((l) => /^\s*([A-Z]\w*)?Error\b.*:/.test(l)) ?? lines2.find((l) => /Error/.test(l)) ?? lines2[0];
    tool.errors.push(`could not load ${path3.basename(file)}: ${msg}`);
    return tool;
  }
  const raw = { name: folder, ...meta2 };
  const { errors, warnings, def } = checkDefinition(raw, folder);
  tool.errors.push(...errors);
  tool.warnings.push(...warnings.filter((w) => !w.startsWith('unknown key "name"')));
  if (def) {
    tool.def = def;
    def.examples?.forEach((ex, i) => {
      for (const msg of validateInput(def, ex.input)) tool.errors.push(`examples[${i}]: ${msg}`);
    });
  }
  tool.ok = tool.errors.length === 0;
  return tool;
}
function loadToolEntry(entry, source, opts) {
  return entry.endsWith(".mjs") ? loadToolFile(entry, source, opts) : loadToolFolder(entry, source);
}
function listToolEntries(root) {
  if (!existsSync3(root)) return [];
  return readdirSync2(root, { withFileTypes: true }).filter((d) => !d.name.startsWith(".") && (d.isDirectory() || d.isFile() && d.name.endsWith(".mjs"))).map((d) => path3.join(root, d.name)).sort();
}

// packages/server/src/registry.ts
async function runToolExamples(tool, opts) {
  const examples = tool.def?.examples ?? [];
  if (!examples.length) return;
  if (!opts.execAllowed) {
    tool.examples = { passed: 0, failed: 0, failures: [], skipped: "execution is disabled (TROD_ALLOW_EXEC is not 1)" };
    return;
  }
  const report = { passed: 0, failed: 0, failures: [] };
  for (const [i, ex] of examples.entries()) {
    const res = await executeTool({
      runner: tool.runner,
      runPath: tool.runPath,
      toolDir: tool.dir,
      toolName: tool.def.name,
      projectDir: opts.projectDir,
      input: ex.input,
      timeoutMs: tool.def.timeoutMs,
      sessionId: opts.sessionId,
      env: opts.env
    });
    const failure2 = res.ok ? checkExpectation(ex.expect, res.text, res.value) : `threw: ${res.error ?? res.text.slice(0, 500)}`;
    if (failure2) {
      report.failed++;
      report.failures.push(`examples[${i}]${ex.description ? ` (${ex.description})` : ""}: ${failure2}`);
    } else report.passed++;
  }
  tool.examples = report;
  if (report.failed) {
    tool.ok = false;
    tool.errors.push(...report.failures);
  }
}

// packages/server/src/promote.ts
async function promoteTool(paths, name, now = /* @__PURE__ */ new Date(), opts = {}) {
  const execAllowed = opts.execAllowed ?? (opts.env ?? process.env).TROD_ALLOW_EXEC === "1";
  const file = path4.join(paths.toolsDir, `${name}.mjs`);
  const single = !existsSync4(path4.join(paths.toolsDir, name)) && existsSync4(file);
  const from = single ? file : path4.join(paths.toolsDir, name);
  const to = path4.join(paths.libraryDir, path4.basename(from));
  if (!existsSync4(from)) throw new Error(`no session tool "${name}" in ${path4.relative(paths.projectDir, paths.toolsDir) || paths.toolsDir}`);
  const loaded = await loadToolEntry(from, "session", { execAllowed, env: opts.env });
  if (loaded.ok) await runToolExamples(loaded, { projectDir: paths.projectDir, execAllowed, env: opts.env });
  if (!loaded.ok) throw new Error(`"${name}" is invalid and cannot be promoted:
- ${loaded.errors.join("\n- ")}`);
  mkdirSync2(paths.libraryDir, { recursive: true });
  const replaced = existsSync4(to);
  const staging = path4.join(paths.trodDir, `.promote-${name}-${process.pid}${single ? ".mjs" : ""}`);
  rmSync(staging, { recursive: true, force: true });
  cpSync(from, staging, { recursive: true });
  if (single) {
    writeFileSync(staging, `${readFileSync3(staging, "utf8").trimEnd()}
// trod: promoted ${now.toISOString()}
`);
  } else {
    const jsonPath = path4.join(staging, "tool.json");
    const def = JSON.parse(readFileSync3(jsonPath, "utf8"));
    def.provenance = { ...def.provenance, promotedAt: now.toISOString() };
    writeFileSync(jsonPath, JSON.stringify(def, null, 2) + "\n");
  }
  if (replaced) rmSync(to, { recursive: true, force: true });
  renameSync(staging, to);
  rmSync(from, { recursive: true, force: true });
  return { name, from, to, replaced, examplesPassed: loaded.examples?.passed ?? 0 };
}

