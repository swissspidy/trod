function executeTool(opts) {
  const started = performance.now();
  const timeoutMs = Math.min(opts.timeoutMs ?? DEFAULT_TIMEOUT_MS, MAX_TIMEOUT_MS);
  const maxOutputChars = opts.maxOutputChars ?? DEFAULT_MAX_OUTPUT_CHARS;
  const parentEnv = opts.env ?? process.env;
  const passthrough = (parentEnv.TROD_ENV_PASSTHROUGH ?? "").split(",").map((s) => s.trim()).filter(Boolean);
  const env = scrubEnv(parentEnv, {
    passthrough,
    extra: {
      TROD_PROJECT_DIR: opts.projectDir,
      TROD_TOOL_DIR: opts.toolDir,
      TROD_TOOL_NAME: opts.toolName,
      TROD_RUN_PATH: opts.runPath,
      ...opts.sessionId ? { TROD_SESSION_ID: opts.sessionId } : {}
    }
  });
  const [command, args] = opts.script ? [process.execPath, ["--input-type=module", "-e", opts.script]] : opts.runner === "mjs" ? [process.execPath, ["--input-type=module", "-e", MJS_RUNNER]] : ["bash", [opts.runPath]];
  return new Promise((resolve) => {
    const child = spawn(command, args, {
      cwd: opts.projectDir,
      env,
      detached: true,
      stdio: ["pipe", "pipe", "pipe", "pipe"]
    });
    let stdout = "";
    let stderr = "";
    let fd3 = "";
    let timedOut = false;
    let settled = false;
    const cap = (buf, chunk) => buf.length < MAX_CAPTURE_BYTES ? buf + chunk.toString("utf8") : buf;
    child.stdout.on("data", (c) => stdout = cap(stdout, c));
    child.stderr.on("data", (c) => stderr = cap(stderr, c));
    const resultPipe = child.stdio[3];
    resultPipe?.on("data", (c) => fd3 = cap(fd3, c));
    const killTree = () => {
      try {
        if (child.pid) process.kill(-child.pid, "SIGKILL");
      } catch {
        child.kill("SIGKILL");
      }
    };
    const timer = setTimeout(() => {
      timedOut = true;
      killTree();
    }, timeoutMs);
    const finish = (partial2) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      const { text, truncated } = truncateOutput(partial2.text, maxOutputChars);
      resolve({
        ok: partial2.ok,
        value: partial2.value,
        error: partial2.error,
        text,
        truncated,
        outputChars: partial2.text.length,
        durationMs: Math.round(performance.now() - started),
        timedOut,
        ...partial2.calls ? { calls: partial2.calls } : {}
      });
    };
    child.on("error", (err) => finish({ ok: false, error: err.message, text: `trod: could not start tool: ${err.message}` }));
    child.on("close", (code, signal) => {
      killTree();
      if (timedOut) {
        const msg = `trod: tool timed out after ${timeoutMs} ms and was killed.`;
        finish({ ok: false, error: msg, text: msg + (stderr ? `
stderr:
${tail(stderr)}` : "") });
        return;
      }
      if (opts.runner === "mjs" || opts.script) {
        let msg;
        try {
          msg = fd3 ? JSON.parse(fd3) : void 0;
        } catch {
          msg = void 0;
        }
        if (msg?.ok) {
          let value = msg.value;
          if ((value === null || value === void 0) && stdout.trim()) value = stdout;
          finish({ ok: true, value, text: formatValue(value), calls: msg.calls });
          return;
        }
        const error3 = msg?.error ?? `tool process exited with ${signal ?? `code ${code}`}`;
        const extra = [stderr && `stderr:
${tail(stderr)}`, stdout && `stdout:
${tail(stdout)}`].filter(Boolean).join("\n");
        finish({ ok: false, error: error3.split("\n")[0], text: `Error: ${error3}${extra ? "\n" + extra : ""}`, calls: msg?.calls });
        return;
      }
      if (code === 0) {
        let value = stdout;
        const trimmed = stdout.trim();
        if (trimmed.startsWith("{") || trimmed.startsWith("[")) {
          try {
            value = JSON.parse(trimmed);
          } catch {
            value = stdout;
          }
        }
        finish({ ok: true, value, text: stdout });
        return;
      }
      const error2 = `run.sh exited with ${signal ?? `code ${code}`}`;
      finish({
        ok: false,
        error: error2,
        text: `Error: ${error2}` + (stderr ? `
stderr:
${tail(stderr)}` : "") + (stdout ? `
stdout:
${tail(stdout)}` : "")
      });
    });
    child.stdin.on("error", () => {
    });
    child.stdin.end(JSON.stringify(opts.input ?? {}));
  });
}

// packages/server/src/logs.ts
import { appendFileSync, existsSync, mkdirSync, readdirSync, readFileSync } from "node:fs";
import path from "node:path";
function readLogs(logsDir) {
  if (!existsSync(logsDir)) return [];
  const records = [];
  for (const file of readdirSync(logsDir).filter((f) => f.endsWith(".jsonl")).sort()) {
    for (const line of readFileSync(path.join(logsDir, file), "utf8").split("\n")) {
      if (!line.trim()) continue;
      try {
        records.push(JSON.parse(line));
      } catch {
      }
    }
  }
  return records;
}

