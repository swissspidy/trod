function validateInput(def, input) {
  let validate2 = validators.get(def.inputSchema);
  if (!validate2) {
    validate2 = ajv.compile(def.inputSchema);
    validators.set(def.inputSchema, validate2);
  }
  if (validate2(input)) return [];
  return (validate2.errors ?? []).map((e) => `input${e.instancePath} ${e.message ?? "is invalid"}`);
