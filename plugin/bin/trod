function resolveProjectDir(env = process.env, cwd = process.cwd()) {
  const configured = env.TROD_PROJECT_DIR || env.CLAUDE_PROJECT_DIR;
  if (configured) return path2.resolve(configured);
  const start = path2.resolve(cwd);
  const home = path2.resolve(homedir());
  for (let dir = start; ; dir = path2.dirname(dir)) {
    if (dir === home && dir !== start) return start;
    if (existsSync2(path2.join(dir, ".trod")) || existsSync2(path2.join(dir, ".codex"))) return dir;
    if (existsSync2(path2.join(dir, ".git")) || path2.dirname(dir) === dir) return start;
  }
}
