// packages/cli/src/forge.ts
import { ANTIGRAVITY_NOTES_RULE, codexNotesFile, linkAntigravityNotes, linkCodexNotes, linkNotes, NOTES_IMPORT, NOTES_MAX_CHARS, promoteTool, trodPaths, verifyNotes } from "../server/trod-lib.mjs";
var FORGE_PROMPT = `You are a toolsmith. You are not solving a task: you are building tools that future sessions will rely on.

Future sessions start fresh, with no memory of this one. They will see the tools you build listed in their instructions (name, signature, description, whenToUse, whether the examples pass) and call them, usually several at once from trod_eval as tools.<name>(input). They will not read your source. So:

1. Study the environment described below and in the project's files. Probe it until you understand every quirk: authentication, pagination, rate limits (back off on 429), formats (dates, numbers, units), soft-deleted or reversed records, anything a newcomer would get wrong.
2. Build a few general capability tools as single files in .trod/tools/<name>.mjs (export const meta = { description, whenToUse, inputSchema, examples, timeoutMs }; export default async (input, ctx) => result). A capability returns clean, normalized records with useful filters; it does not compute one particular answer. Encode every quirk inside the tool.
3. Write description and whenToUse so that a newcomer can use the tool correctly without reading code: say what it returns (field names, units, what is excluded) and which quirks it handles. These texts are the only documentation future sessions get.
4. Give every tool at least one example that exercises the real environment and checks something stable (expect.contains or expect.matches). Tools whose examples fail are discarded.
5. Test each tool with trod_run, and test combining them with trod_eval, like a future session would.
6. Write .trod/notes.md: what future sessions need to KNOW about the environment itself (at most 4000 characters, dense and concrete). Write RULES, each saying what to do or not do: "X means Y; do Z", not bare facts. Cover the conventions a newcomer gets wrong: what fields and coded values mean, how derived quantities are defined, which records count (scope: act on exactly the records the task selects, all of them, and nothing else; skip records already in the target state), how domain rules work (money, limits, defaults, side effects), date and unit formats, how results are expected to be shaped, traps. When you name a trap, also name the right action: a warning without one invites improvised fixes that become unrequested side effects. Do NOT spend the notes on how to use your tools or on API reference that the docs already give: tool descriptions carry the former, and the notes must stay useful even when a session works without the tools. These notes are loaded into every future session, so state general rules, not answers to one task, and check each claim against the environment.
7. Back every checkable claim with an entry in .trod/notes.checks.json: a JSON array of {"claim": "<a few words>", "tool": "<one of your tools>", "input": {...}, "expect": {"contains": "..."} or {"matches": "<regex>"}}. The checks are re-run later to detect when the environment changes and a note goes stale; claims whose check fails are reported.

Do not write answer files. When finished, reply with a short list of the tools and DONE.`;
var PRACTICE_PROMPT = (hasReset) => `## Practice

You can practise on the environment itself. \`trod-try\` runs the practice check: it exits 0 when the current attempt succeeded, and its output says why when it did not.${hasReset ? " `trod-reset` starts a fresh attempt (a new instance of the same kind of task)." : ""} Make real attempts until they succeed reliably (at least 3 in a row where you can), and learn from every failure: what ends an attempt, what success needs that nobody says, which actions are reliable, which are traps. Then write into .trod/notes.md the rules you saw hold, each with the action to take, plus a short recipe that worked, with <placeholders> for what differs between attempts. Run checks only through \`trod-try\`: notes from a forge that never passed it are not linked.`;
function writePracticeBins(binDir, logFile, practice) {
  mkdirSync(binDir, { recursive: true });
  writeFileSync(path.join(binDir, "package.json"), '{"type":"commonjs"}\n');
  const bin = (cmd, kind) => `#!/usr/bin/env node
const { spawnSync } = require('node:child_process');
const { appendFileSync } = require('node:fs');
const r = spawnSync('sh', ['-c', ${JSON.stringify(cmd)}, 'sh', ...process.argv.slice(2)], { stdio: 'inherit' });
const code = r.status === null ? 1 : r.status;
appendFileSync(${JSON.stringify(logFile)}, JSON.stringify({ kind: ${JSON.stringify(kind)}, exit: code, at: new Date().toISOString() }) + '\\n');
process.exit(code);
`;
  for (const [name, cmd, kind] of [["trod-try", practice.check, "try"], ["trod-reset", practice.reset, "reset"]]) {
    if (!cmd) continue;
    writeFileSync(path.join(binDir, name), bin(cmd, kind));
    chmodSync(path.join(binDir, name), 493);
  }
}
function readPractice(logFile) {
  const lines2 = existsSync(logFile) ? readFileSync(logFile, "utf8").split("\n").filter(Boolean) : [];
  const entries = [];
  let corrupt = 0;
  for (const l of lines2) {
    try {
      entries.push(JSON.parse(l));
    } catch {
      corrupt++;
    }
  }
  const tries = entries.filter((e) => e.kind === "try");
  return { attempts: tries.length, passed: tries.filter((e) => e.exit === 0).length, corrupt };
}
function defaultServerPath() {
  return path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "server", "trod-server.mjs");
}
function lastResultEvent(stream) {
  const lines2 = stream.split("\n");
  for (let i = lines2.length - 1; i >= 0; i--) {
    if (!lines2[i].includes('"type":"result"')) continue;
    try {
      return JSON.parse(lines2[i]);
    } catch {
    }
  }
  return void 0;
}
async function forge(opts) {
  const scratch = mkdtempSync(path.join(tmpdir(), "trod-forge-"));
  try {
    return await runForge(opts, scratch);
  } finally {
    rmSync(scratch, { recursive: true, force: true });
  }
}
async function runForge(opts, scratch) {
  const out = opts.out ?? (() => {
  });
  const paths = trodPaths(opts.projectDir);
  const baseEnv = opts.env ?? process.env;
  const practiceLog = path.join(scratch, "practice.jsonl");
  if (opts.practice) writePracticeBins(path.join(scratch, "bin"), practiceLog, opts.practice);
  const env = { ...baseEnv, [TROD_SESSION_ENV]: baseEnv[TROD_SESSION_ENV] ?? "forge", TROD_ALLOW_EXEC: "1", TROD_PROJECT_DIR: opts.projectDir, ...opts.practice ? { PATH: `${path.join(scratch, "bin")}${path.delimiter}${baseEnv.PATH ?? ""}` } : {} };
  delete env.CLAUDECODE;
  const mcpConfig = path.join(scratch, "mcp.json");
  writeFileSync(mcpConfig, JSON.stringify({ mcpServers: { trod: { command: process.execPath, args: [opts.server ?? defaultServerPath()] } } }));
  const prompt = `${opts.prompt ?? FORGE_PROMPT}

## The environment

${opts.brief}${opts.practice ? `

${PRACTICE_PROMPT(!!opts.practice.reset)}` : ""}`;
  const args = [
    "-p",
    prompt,
    "--output-format",
    "stream-json",
    "--verbose",
    "--mcp-config",
    mcpConfig,
    "--strict-mcp-config",
    "--allowedTools",
    "Bash,Read,Write,Edit,Glob,Grep,TodoWrite,mcp__trod__*",
    "--disallowedTools",
    "WebFetch,WebSearch,Task,Agent",
    ...opts.model ? ["--model", opts.model] : [],
    ...opts.maxBudgetUsd ? ["--max-budget-usd", opts.maxBudgetUsd] : []
  ];
  const streamFile = opts.streamFile ?? path.join(scratch, "forge.jsonl");
  mkdirSync(path.dirname(streamFile), { recursive: true });
  out(`${opts.activity ?? "forging tools"} in ${opts.projectDir}${opts.model ? ` with ${opts.model}` : ""} \u2026 (a headless Claude Code session; this takes a few minutes)`);
  const claudeBin = opts.claudeBin ?? baseEnv.TROD_CLAUDE_BIN ?? "claude";
  const { exitCode, stream, spawnError } = await new Promise((resolve) => {
    const child = spawn(claudeBin, args, { cwd: opts.projectDir, env, stdio: ["ignore", "pipe", "inherit"] });
    let buf = "";
    child.stdout.setEncoding("utf8");
    child.stdout.on("data", (c) => buf += c);
    const timer = setTimeout(() => child.kill("SIGKILL"), opts.timeoutMs ?? 30 * 6e4);
    child.on("close", (code) => {
      clearTimeout(timer);
      resolve({ exitCode: code, stream: buf });
    });
    child.on("error", (err) => {
      clearTimeout(timer);
      resolve({ exitCode: null, stream: buf, spawnError: err.message });
    });
  });
  if (spawnError) {
    out(`  could not start Claude Code (${claudeBin}): ${spawnError}. trod forge, learn and tune need the \`claude\` CLI (or TROD_CLAUDE_BIN).`);
    return { exitCode: null, promoted: [], rejected: [], unverified: [] };
  }
  writeFileSync(streamFile, stream);
  const practice = opts.practice ? readPractice(practiceLog) : void 0;
  if (practice) out(`  practice: ${practice.passed}/${practice.attempts} attempt(s) passed${practice.corrupt ? ` (${practice.corrupt} unreadable log line(s) skipped)` : ""}`);
  const result = lastResultEvent(stream);
  const promoted = [];
  const rejected = [];
  const unverified = [];
  const entries = existsSync(paths.toolsDir) ? readdirSync(paths.toolsDir).filter((f) => !f.startsWith(".")) : [];
  for (const entry of entries) {
    const name = entry.replace(/\.mjs$/, "");
    try {
      const res = await promoteTool(paths, name, /* @__PURE__ */ new Date(), { execAllowed: true, env });
      if (!res.examplesPassed) unverified.push(name);
      promoted.push(name);
      out(`  promoted ${name}${res.examplesPassed ? ` (${res.examplesPassed} example(s) passed)` : " (no examples)"}`);
    } catch (err) {
      rejected.push({ name, reason: err.message.split("\n").slice(0, 3).join(" ") });
      out(`  rejected ${name}: ${err.message.split("\n")[0]}`);
    }
  }
  const notes = await verifyNotes(paths, { execAllowed: true, env });
  let notesLinkedNow = false;
  if (notes.exists) {
    const passed2 = notes.checks.filter((c) => c.ok).length;
    out(`  notes: ${notes.chars} chars${notes.tooLong ? ` (over ${NOTES_MAX_CHARS}: trim them, they are in every session's context)` : ""}, ${notes.checks.length ? `${passed2}/${notes.checks.length} check(s) passed` : "no checks"}`);
    for (const c of notes.checks.filter((c2) => !c2.ok)) out(`    failed check "${c.claim}" (${c.tool}): ${c.error}`);
    for (const e of notes.errors) out(`    ${e}`);
    if (practice && practice.passed === 0) notes.errors.push("the forge never passed the practice check (trod-try), so nothing in these notes was seen to work");
    const failed = notes.checks.some((c) => !c.ok) || notes.errors.length > 0;
    if (failed && notes.linked) out(notes.delivery === "hooks" ? "  WARNING: trod's hooks deliver .trod/notes.md to sessions, so they still get these unverified notes: fix the failing claims or turn hooks delivery off (trod notes --delivery import)" : `  WARNING: CLAUDE.md already imports .trod/notes.md (${NOTES_IMPORT}), so sessions still load these unverified notes: fix the failing claims or remove the import`);
    else if (failed) out("  notes NOT linked into CLAUDE.md: fix or remove the failing claims and their checks, then run `trod notes --link`");
    else if (exitCode !== 0) out(`  notes NOT linked into CLAUDE.md: the session did not finish cleanly (${exitCode === null ? "killed, e.g. by --timeout" : `exit code ${exitCode}`}), so they may be incomplete; review them, then run \`trod notes --link\``);
    else if (opts.linkNotes !== false) {
      notesLinkedNow = linkNotes(paths);
      if (notesLinkedNow) out(`  linked .trod/notes.md into CLAUDE.md (${NOTES_IMPORT})${notes.checks.length ? "" : ` (${opts.notesBasis ?? "no checks: nothing in them is verified"})`}`);
      const rule = linkAntigravityNotes(paths);
      if (rule === "written") out(`  linked .trod/notes.md into Antigravity (${ANTIGRAVITY_NOTES_RULE})`);
      else if (typeof rule === "object") out(`  ${rule.error}`);
      const codex = linkCodexNotes(paths);
      if (codex === "written") out(`  linked .trod/notes.md into Codex (${codexNotesFile(paths)})`);
      else if (typeof codex === "object") out(`  ${codex.error}`);
    }
  }
  return { exitCode, promoted, rejected, unverified, notes: notes.exists ? { ...notes, linked: notes.linked || notesLinkedNow } : void 0, costUsd: result?.total_cost_usd, turns: result?.num_turns, usage: result?.usage, practice };
}

// packages/cli/src/learn.ts
import { closeSync, existsSync as existsSync2, mkdirSync as mkdirSync2, openSync, readdirSync as readdirSync2, readSync, readFileSync as readFileSync2, realpathSync, statSync, unlinkSync, writeFileSync as writeFileSync2 } from "node:fs";
import { homedir } from "node:os";
import path2 from "node:path";
function transcriptDir(projectDir, configDir = process.env.CLAUDE_CONFIG_DIR || path2.join(homedir(), ".claude")) {
  return path2.join(configDir, "projects", path2.resolve(projectDir).replace(/[^a-zA-Z0-9]/g, "-"));
}
function codexSessionsDir(codexHome = process.env.CODEX_HOME || path2.join(homedir(), ".codex")) {
  return path2.join(codexHome, "sessions");
}
var headBuf;
function codexSessionCwd(file) {
  try {
    const buf = headBuf ??= Buffer.allocUnsafe(256 * 1024);
    const fd = openSync(file, "r");
    let n;
    try {
      n = readSync(fd, buf, 0, buf.length, 0);
    } finally {
      closeSync(fd);
    }
    const head = buf.subarray(0, n).toString("utf8");
    const e = JSON.parse(head.slice(0, head.indexOf("\n") >= 0 ? head.indexOf("\n") : void 0));
    return e.type === "session_meta" ? e.payload?.cwd : void 0;
  } catch {
    return void 0;
  }
}
function codexTranscripts(projectDir, sessionsDir = codexSessionsDir()) {
  const real = (p) => {
    try {
      return realpathSync(p);
    } catch {
      return path2.resolve(p);
    }
  };
  const inside = (dir, root2) => dir === root2 || dir.startsWith(root2 + path2.sep);
  const written = path2.resolve(projectDir);
  const root = real(projectDir);
  return findTranscripts([sessionsDir]).filter((f) => {
    const cwd = codexSessionCwd(f);
    if (cwd === void 0) return false;
    return inside(path2.resolve(cwd), written) || inside(real(cwd), root);
  });
}
function findTranscripts(sources) {
  const found = /* @__PURE__ */ new Map();
  const seenDirs = /* @__PURE__ */ new Set();
  const walk = (p) => {
    if (!existsSync2(p)) return;
    const real = realpathSync(p);
    const stat = statSync(real);
    if (stat.isDirectory()) {
      if (seenDirs.has(real)) return;
      seenDirs.add(real);
      for (const e of readdirSync2(real).sort()) walk(path2.join(p, e));
    } else if (p.endsWith(".jsonl") && !found.has(real)) found.set(real, { file: p, mtimeMs: stat.mtimeMs });
  };
  for (const s of sources) walk(s);
  return [...found.values()].sort((a, b) => b.mtimeMs - a.mtimeMs).map((f) => f.file);
}
var TROD_TASK = /^You are (a toolsmith|distilling experience|tuning notes)/;
var CLAUDE_WRAPPER = /^<(command-[a-z]+|local-command-[a-z]+|system-reminder|bash-(input|stdout|stderr)|task-notification|user-memory-input)>/;
var clip = (s, n) => s.length > n ? `${s.slice(0, n)} \u2026[${s.length - n} more chars]` : s;
function textOf(content) {
  if (typeof content === "string") return content;
  if (Array.isArray(content)) return content.map((c) => typeof c === "string" ? c : c?.type === "text" ? c.text : c?.type === "image" ? "[image]" : "").join("\n");
  return "";
}
function digestTranscript(file, opts = {}) {
  const events = [];
  for (const line of readFileSync2(file, "utf8").split("\n")) {
    if (!line.trim()) continue;
    try {
      events.push(JSON.parse(line));
    } catch {
    }
  }
  if (events[0]?.type === "session_meta") return digestCodex(file, events, opts);
  let task = opts.task ?? "";
  const steps = [];
  let toolCalls = 0;
  let errors = 0;
  let final = "";
  let learnRun = false;
  for (const e of events) {
    if (e.type === "user" && !learnRun && textOf(e.message?.content).includes(LEARN_RUN_MARKER)) learnRun = true;
    if (e.isSidechain || e.isMeta) continue;
    const msg = e.message;
    if (e.type === "user" && msg) {
      const blocks = typeof msg.content === "string" ? [{ type: "text", text: msg.content }] : msg.content ?? [];
      for (const c of blocks) {
        if (c?.type === "tool_result") {
          if (c.is_error) errors++;
          steps.push(`${c.is_error ? "ERROR" : "RESULT"}: ${clip(textOf(c.content).trim(), 700)}`);
        } else if (c?.type === "text") {
          const t = (c.text ?? "").trim();
          if (!t || CLAUDE_WRAPPER.test(t)) continue;
          if (!task) task = t;
          else steps.push(`USER: ${clip(t, 600)}`);
        }
      }
    } else if (e.type === "assistant" && msg && Array.isArray(msg.content)) {
      for (const c of msg.content) {
        if (c?.type === "text" && c.text?.trim()) {
          final = c.text.trim();
          steps.push(`ASSISTANT: ${clip(final, 500)}`);
        } else if (c?.type === "tool_use") {
          toolCalls++;
          const input = c.input;
          const shown = typeof input?.command === "string" ? input.command : JSON.stringify(input);
          steps.push(`CALL ${c.name}: ${clip(shown ?? "", 500)}`);
        }
      }
    } else if (e.type === "result" && typeof e.result === "string") {
      final = e.result;
    }
  }
  return assembleDigest(file, { task, steps, toolCalls, errors, final, learnRun }, opts);
}
function assembleDigest(file, d, opts) {
  const { task, steps, toolCalls, errors, final, learnRun } = d;
  const maxChars = opts.maxChars ?? 8e3;
  if (!task && !steps.length) return void 0;
  const id = path2.basename(file, ".jsonl");
  const outcome = opts.outcome ?? "unknown";
  const head = `# Session ${id}: ${outcome.toUpperCase()}

## Task

${clip(task, 1500)}

## Steps (${toolCalls} tool calls, ${errors} errors)

`;
  const finalPart = (shown) => final && !shown.includes(clip(final, 500)) ? `
## Final message

${clip(final, 800)}
` : "";
  let body = steps.map((s, i) => `${i + 1}. ${s}`).join("\n");
  const OMITTED = "\n\u2026[middle of the session omitted]\u2026\n";
  if (head.length + body.length + 1 + finalPart(body).length > maxChars) {
    const budget = Math.max(500, maxChars - head.length - 1 - finalPart("").length - OMITTED.length);
    body = `${body.slice(0, Math.floor(budget * 0.6))}${OMITTED}${body.slice(-Math.floor(budget * 0.4))}`;
  }
  return { id, file, task, outcome, toolCalls, errors, learnRun, text: `${head}${body}
${finalPart(body)}` };
}
var CODEX_WRAPPER = /^(<(environment_context|user_instructions|skills_instructions|turn_aborted|user_shell_command|subagent_notification|permissions instructions|apps_instructions|collaboration_mode|multi_agent_[a-z_]+)>|# AGENTS\.md instructions)/;
function codexOutput(output) {
  let value = output;
  if (typeof value === "string" && value.trimStart().startsWith("{")) {
    try {
      value = JSON.parse(value);
    } catch {
    }
  }
  if (Array.isArray(value)) {
    const text2 = value.map((b) => b?.text ?? "").join("\n");
    return { text: text2, error: /^(Exit code|Process exited with code):? *[1-9]/m.test(text2) };
  }
  if (value && typeof value === "object") {
    const o = value;
    const text2 = typeof o.output === "string" ? o.output : typeof o.content === "string" ? o.content : JSON.stringify(value);
    return { text: text2, error: (o.metadata?.exit_code ?? 0) !== 0 || o.success === false };
  }
  const text = String(value ?? "");
  return { text, error: /^(Exit code|Process exited with code):? *[1-9]/m.test(text) };
}
function codexFailedCalls(events) {
  const failed = /* @__PURE__ */ new Map();
  for (const e of events) {
    const p = e.payload;
    if (e.type === "event_msg" && p?.type === "item_completed" && p.item?.type === "McpToolCall" && p.item.id && (p.item.status === "failed" || p.item.result?.isError)) failed.set(p.item.id, p.item.error?.message ?? "failed");
  }
  return failed;
}
function codexUnmatchedFailures(events, failed) {
  const answered = /* @__PURE__ */ new Set();
  for (const e of events) {
    const p = e.payload;
    if (e.type === "response_item" && (p?.type === "function_call_output" || p?.type === "custom_tool_call_output") && p.call_id) answered.add(p.call_id);
  }
  return [...failed].filter(([id]) => !answered.has(id)).map(([, message]) => message);
}
function digestCodex(file, events, opts) {
  let task = opts.task ?? "";
  const steps = [];
  let toolCalls = 0;
  let errors = 0;
  let final = "";
  let learnRun = false;
  const failedMcp = codexFailedCalls(events);
  for (const e of events) {
    if (e.type !== "response_item") continue;
    const item = e.payload ?? {};
    if (item.type === "message") {
      const text = (item.content ?? []).map((c) => c?.type === "input_text" || c?.type === "output_text" ? c.text ?? "" : "").join("\n").trim();
      if (item.role === "user") {
        if (text.includes(LEARN_RUN_MARKER)) learnRun = true;
        if (!text || CODEX_WRAPPER.test(text)) continue;
        if (!task) task = text;
        else steps.push(`USER: ${clip(text, 600)}`);
      } else if (item.role === "assistant" && text) {
        final = text;
        steps.push(`ASSISTANT: ${clip(text, 500)}`);
      }
    } else if (item.type === "function_call" || item.type === "custom_tool_call") {
      toolCalls++;
      let shown = item.arguments ?? item.input ?? "";
      try {
        const args = JSON.parse(shown);
        const cmd = args.command ?? args.cmd;
        if (Array.isArray(cmd)) shown = cmd.join(" ");
        else if (typeof cmd === "string") shown = cmd;
      } catch {
      }
      steps.push(`CALL ${item.name}: ${clip(shown, 500)}`);
    } else if (item.type === "function_call_output" || item.type === "custom_tool_call_output") {
      const out = codexOutput(item.output);
      const text = out.text;
      const error = out.error || item.call_id !== void 0 && failedMcp.has(item.call_id);
      if (error) errors++;
      steps.push(`${error ? "ERROR" : "RESULT"}: ${clip(text.trim(), 700)}`);
    }
  }
  for (const message of codexUnmatchedFailures(events, failedMcp)) {
    errors++;
    steps.push(`ERROR: ${clip(message, 700)}`);
  }
  return assembleDigest(file, { task, steps, toolCalls, errors, final, learnRun }, opts);
}
function pickSessions(files, opts = {}) {
  const picked = [];
  let skipped = 0;
  for (const file of files) {
    if (picked.length >= (opts.limit ?? Infinity)) break;
    const id = path2.basename(file, ".jsonl");
    if (opts.seen?.has(id)) {
      skipped++;
      continue;
    }
    const d = digestTranscript(file, { outcome: opts.outcomes?.get(id) });
    if (d && !d.learnRun && !TROD_TASK.test(d.task)) picked.push(d);
  }
  return { picked, skipped };
}
function readOutcomes(file) {
  const raw = JSON.parse(readFileSync2(file, "utf8"));
  const map = /* @__PURE__ */ new Map();
  for (const [k, v] of Object.entries(raw)) {
    const o = v === true || v === "pass" || typeof v === "number" && v > 0 ? "pass" : v === false || v === "fail" || v === 0 ? "fail" : "unknown";
    map.set(path2.basename(k, ".jsonl"), o);
  }
  return map;
}
function writeDigests(dir, digests) {
  mkdirSync2(dir, { recursive: true });
  const counts = { pass: 0, fail: 0, unknown: 0 };
  const index = ["# Sessions", "", "| file | outcome | tool calls | errors | task (first line) |", "|---|---|---|---|---|"];
  digests.forEach((d, i) => {
    counts[d.outcome]++;
    const name = `${String(i + 1).padStart(3, "0")}-${d.outcome}.md`;
    writeFileSync2(path2.join(dir, name), d.text);
    const firstLine = d.task.split("\n").find((l) => /\w/.test(l) && !/^you are\b/i.test(l)) ?? d.task.split("\n")[0] ?? "";
    index.push(`| ${name} | ${d.outcome} | ${d.toolCalls} | ${d.errors} | ${clip(firstLine.replace(/\|/g, "/").trim(), 160)} |`);
  });
  writeFileSync2(path2.join(dir, "INDEX.md"), index.join("\n") + "\n");
  return counts;
}
var LEARN_STATE_DIR = path2.join(".trod", "state");
var LEARN_STATE_FILE = path2.join(LEARN_STATE_DIR, "learn.json");
var LEARN_LOCK_FILE = path2.join(LEARN_STATE_DIR, "learn.lock");
var LEDGER_FILE = path2.join(".trod", "notes.evidence.json");
var LEARN_RUN_MARKER = "trod-learn-run-7c1e5a";
function readLearnState(projectDir) {
  try {
    const raw = JSON.parse(readFileSync2(path2.join(projectDir, LEARN_STATE_FILE), "utf8"));
    return { lastRun: typeof raw.lastRun === "string" ? raw.lastRun : void 0, sessions: Array.isArray(raw.sessions) ? raw.sessions.filter((x) => typeof x === "string") : [] };
  } catch {
    return { sessions: [] };
  }
}
function ensureStateDir(projectDir) {
  const dir = path2.join(projectDir, LEARN_STATE_DIR);
  mkdirSync2(dir, { recursive: true });
  if (!existsSync2(path2.join(dir, ".gitignore"))) writeFileSync2(path2.join(dir, ".gitignore"), "# machine-local trod state (learned sessions, locks, per-session notes delivery)\n*\n");
}
function pidAlive(pid) {
  if (!(pid > 0)) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (err) {
    return err.code === "EPERM";
  }
}
function learnLockHeld(projectDir) {
  try {
    return pidAlive(Number(readFileSync2(path2.join(projectDir, LEARN_LOCK_FILE), "utf8")));
  } catch {
    return false;
  }
}
function writeLearnState(projectDir, learned, now = /* @__PURE__ */ new Date()) {
  ensureStateDir(projectDir);
  const sessions = [.../* @__PURE__ */ new Set([...readLearnState(projectDir).sessions, ...learned])];
  writeFileSync2(path2.join(projectDir, LEARN_STATE_FILE), JSON.stringify({ lastRun: now.toISOString(), sessions }, null, 2) + "\n");
}
function acquireLearnLock(projectDir) {
  ensureStateDir(projectDir);
  const lock = path2.join(projectDir, LEARN_LOCK_FILE);
  for (let attempt = 0; attempt < 2; attempt++) {
    try {
      writeFileSync2(lock, String(process.pid), { flag: "wx" });
      return () => {
        try {
          if (readFileSync2(lock, "utf8") === String(process.pid)) unlinkSync(lock);
        } catch {
        }
      };
    } catch {
      if (learnLockHeld(projectDir)) return void 0;
      try {
        unlinkSync(lock);
      } catch {
      }
    }
  }
  return void 0;
}
function readLedger(projectDir) {
  const file = path2.join(projectDir, LEDGER_FILE);
  if (!existsSync2(file)) return { rules: [], errors: [], exists: false };
  let raw;
  try {
    raw = JSON.parse(readFileSync2(file, "utf8"));
  } catch (err) {
    return { rules: [], errors: [`${LEDGER_FILE}: ${err.message}`], exists: true };
  }
  const list = raw?.rules;
  if (!Array.isArray(list)) return { rules: [], errors: [`${LEDGER_FILE}: expected {"rules": [...]}`], exists: true };
  const rules = [];
  const errors = [];
  list.forEach((r, i) => {
    const o = r;
    const ok = o && typeof o.id === "string" && Number.isInteger(o.confirmed) && Number.isInteger(o.contradicted) && ["new", "kept", "fixed", "dropped"].includes(o.status);
    if (ok) rules.push(o);
    else errors.push(`${LEDGER_FILE}: rule ${i + 1} needs id, confirmed, contradicted (integers) and status (new|kept|fixed|dropped)`);
  });
  return { rules, errors, exists: true };
}
function checkLedgerHistory(before, after, relearn) {
  const now = new Map(after.map((r) => [r.id, r]));
  const errors = [];
  for (const old of before) {
    const r = now.get(old.id);
    if (!r) errors.push(`${LEDGER_FILE}: rule "${old.id}" disappeared (keep it; mark it "dropped" if it no longer holds)`);
    else if (old.status === "dropped" && r.status !== "dropped") errors.push(`${LEDGER_FILE}: dropped rule "${old.id}" came back as "${r.status}"`);
    else if (!relearn && (r.confirmed < old.confirmed || r.contradicted < old.contradicted)) errors.push(`${LEDGER_FILE}: counts of "${old.id}" went down (add this run's counts to the earlier ones)`);
  }
  return errors;
}
function summarizeLedger(rules) {
  const by = (s) => rules.filter((r) => r.status === s).length;
  const disputed = rules.filter((r) => r.status !== "dropped" && r.contradicted > r.confirmed).length;
  return `${rules.length} rule(s): ${by("kept")} kept, ${by("fixed")} fixed, ${by("new")} new, ${by("dropped")} dropped${disputed ? `; ${disputed} contradicted more often than confirmed` : ""}`;
}
var LEARN_PROMPT = (dir, counts, previous, relearn = false) => `You are distilling experience. You are not solving a task: you are writing the notes that future sessions in this project will load, so that they avoid the mistakes earlier sessions made and repeat what worked.

Earlier sessions in this environment are condensed in ${dir}: INDEX.md lists them (${counts.pass} passed, ${counts.fail} failed, ${counts.unknown} with unknown outcome), one file per session. Future sessions start fresh and see only what you write.

1. Read INDEX.md, then the sessions. Group them by kind of task. Within a group, compare failed sessions with passed ones: find the step where a failed session went wrong, and what the passed sessions did instead. For sessions with an unknown outcome, judge from errors, retries, user corrections and the final message.
2. Keep only lessons that hold across sessions or that explain a failure clearly. Do not invent rules that no session supports. Where you can, confirm a lesson against the environment itself (read the code, run a harmless command).
3. Write .trod/notes.md as RULES, each with the action to take: "X ends the attempt; do Y first", "Z is required even when the task does not say so". Put the rules that apply to most tasks first. Then, for each kind of task that needs its own rules, add a short recipe that worked, with <placeholders> for what differs between tasks. Keep the whole file under 4000 characters if you can.
4. If there are many kinds of task and the rules do not fit, keep .trod/notes.md as the general rules plus an index, and put each kind's rules and recipe into .trod/wiki/<kind>.md (under 2000 characters each). Each index line must say when to read the page, e.g. "- Tasks like "<typical task wording>": read \`.trod/wiki/<kind>.md\` first". Start the index with: "Before acting, read the page that matches your task." Start each page with front matter naming the words a task of that kind contains (trod's hooks add the page when a prompt contains one): "---
when: <3-8 distinctive words or short phrases, comma-separated>
---"
5. ${previous?.lastRun ? `These sessions are new since the last learning run (${previous.lastRun}); most of them ran with the current .trod/notes.md and .trod/wiki/ pages loaded. ` : ""}A digest that says "Notes: HOLDOUT" ran without any notes: compare such sessions with similar ones that had the notes, the strongest evidence for or against a rule. If .trod/notes.md already exists, check every existing rule against these sessions before you add anything: did sessions that followed it succeed (confirmed), or fail because of it, or succeed by doing something else (contradicted)? Fix or drop rules that are contradicted more often than confirmed; keep the rest.
   Keep the evidence in ${LEDGER_FILE}: {"rules": [{"id": "<short-kebab-id>", "where": "<file the rule is in>", "confirmed": <count>, "contradicted": <count>, "status": "new" | "kept" | "fixed" | "dropped"}]}. ${relearn ? `This run re-reads sessions that earlier runs already counted, so recount: replace each rule's counts with what these sessions show (do not add them to the old counts), and keep every rule and every "dropped" status that is in the file;` : "Read the file if it exists and add this run's counts to the earlier ones;"} give each new rule an entry with the sessions that support it counted as confirmed; leave dropped rules in the file with status "dropped" so they are not re-learned. Only count sessions where the rule actually applied.
6. Build a trod tool (.trod/tools/<name>.mjs, with examples) only if several sessions repeated the same fiddly multi-step procedure that a tool would make reliable, and back checkable claims with .trod/notes.checks.json as described in the project's trod skill. Most lessons need neither.

Never copy answers to one particular task into the notes: write what transfers to the next task. When finished, reply with the list of rules you wrote and DONE.`;

// packages/cli/src/cli.ts
import { tmpdir as tmpdir3 } from "node:os";

// packages/cli/src/init.ts
import { copyFileSync, existsSync as existsSync3, mkdirSync as mkdirSync3, readFileSync as readFileSync3, writeFileSync as writeFileSync3 } from "node:fs";
import path3 from "node:path";
import { fileURLToPath as fileURLToPath2 } from "node:url";
import { ANTIGRAVITY_NOTES_RULE as ANTIGRAVITY_NOTES_RULE2, codexNotesFile as codexNotesFile2, linkAntigravityNotes as linkAntigravityNotes2, linkCodexNotes as linkCodexNotes2, notesLinked, trodPaths as trodPaths2 } from "../server/trod-lib.mjs";
function defaultPackageRoot() {
  return path3.resolve(path3.dirname(fileURLToPath2(import.meta.url)), "..");
}
function packageVersion(root) {
  try {
    return JSON.parse(readFileSync3(path3.join(root, "package.json"), "utf8")).version;
  } catch {
    return void 0;
  }
}
function readJson(file) {
  if (!existsSync3(file)) return {};
  const raw = readFileSync3(file, "utf8").trim();
  const value = raw ? JSON.parse(raw) : {};
  if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error(`${file} must contain a JSON object`);
  return value;
}
function writeIfChanged(file, content, res, projectDir) {
  const rel = path3.relative(projectDir, file);
  if (existsSync3(file) && readFileSync3(file, "utf8") === content) {
    res.unchanged.push(rel);
    return;
  }
  mkdirSync3(path3.dirname(file), { recursive: true });
  writeFileSync3(file, content);
  res.written.push(rel);
}
function init(opts) {
  const root = opts.packageRoot ?? defaultPackageRoot();
  const dir = opts.projectDir;
  const res = { written: [], unchanged: [], notes: [] };
  const version = packageVersion(root);
  const spec = version ? `trod@${version}` : "trod";
  if (opts.antigravity && opts.codex) throw new Error("trod init: pick one of --antigravity and --codex (run it twice to set up both)");
  if (opts.antigravity) return initAntigravity(opts, root, spec, res);
  if (opts.codex) return initCodex(opts, root, spec, res);
  let server;
  let hookCommand;
  if (opts.vendor) {
    for (const [from, to] of [
      ["server/trod-server.mjs", ".trod/pkg/server/trod-server.mjs"],
      ["server/trod-lib.mjs", ".trod/pkg/server/trod-lib.mjs"],
      ["bin/trod", ".trod/pkg/bin/trod"],
      ["package.json", ".trod/pkg/package.json"]
    ]) {
      const src = path3.join(root, from);
      if (!existsSync3(src)) throw new Error(`trod init --vendor: ${src} not found`);
      const dest = path3.join(dir, to);
      const before = existsSync3(dest) ? readFileSync3(dest) : void 0;
      mkdirSync3(path3.dirname(dest), { recursive: true });
      copyFileSync(src, dest);
      (before?.equals(readFileSync3(dest)) ? res.unchanged : res.written).push(to);
    }
    server = { command: "node", args: [".trod/pkg/server/trod-server.mjs"] };
    hookCommand = 'node "$CLAUDE_PROJECT_DIR/.trod/pkg/bin/trod" hook';
    res.notes.push("Vendored the server and CLI into .trod/pkg/: commit them, and re-run `trod init --vendor` to update.");
  } else {
    server = { command: "npx", args: ["-y", spec, "mcp"] };
    hookCommand = `npx -y ${spec} hook`;
  }
  const mcpFile = path3.join(dir, ".mcp.json");
  const mcp = readJson(mcpFile);
  const servers = mcp.mcpServers ?? {};
  servers.trod = { ...server, ...opts.allowExec ? { env: { TROD_ALLOW_EXEC: "1" } } : {} };
  mcp.mcpServers = servers;
  writeIfChanged(mcpFile, JSON.stringify(mcp, null, 2) + "\n", res, dir);
  installClaudeHooks(dir, hookCommand, res, { approveMcp: true });
  for (const [from, to] of [["trod", "trod"], ["learn", "trod-learn"]]) {
    const skill = path3.join(root, "skills", from, "SKILL.md");
    if (existsSync3(skill)) writeIfChanged(path3.join(dir, ".claude", "skills", to, "SKILL.md"), readFileSync3(skill, "utf8").replace(/^name: .*$/m, `name: ${to}`), res, dir);
    else res.notes.push(`skill not found at ${skill}; skipped`);
  }
  addIgnores(dir, res);
  if (version === "0.0.0" && !opts.vendor) res.notes.push("This is an unreleased build (0.0.0), which npx cannot fetch: run `trod init --vendor` instead, to copy the server and CLI into the repository.");
  if (opts.allowExec) res.notes.push("TROD_ALLOW_EXEC=1 is set in .mcp.json: tool code runs outside Claude Code's permission prompts. Fine for ephemeral cloud containers; think twice on your own machine.");
  else res.notes.push("Tools do not run until TROD_ALLOW_EXEC=1 is set, and single-file tools are not even registered (re-run with --allow-exec, or set it in your cloud environment's variables).");
  return res;
}
function initAntigravity(opts, root, spec, res) {
  const dir = opts.projectDir;
  if (opts.vendor) throw new Error("trod init --antigravity: --vendor is not supported (Antigravity starts MCP servers outside the project, so a path inside it cannot be resolved)");
  const mcpFile = path3.join(dir, ".agents", "mcp_config.json");
  const mcp = readJson(mcpFile);
  const servers = mcp.mcpServers ?? {};
  const previous = servers.trod ?? {};
  const env = { ...previous.env, ...opts.allowExec ? { TROD_ALLOW_EXEC: "1" } : {} };
  servers.trod = { command: "npx", args: ["-y", spec, "mcp"], ...Object.keys(env).length ? { env } : {} };
  mcp.mcpServers = servers;
  writeIfChanged(mcpFile, JSON.stringify(mcp, null, 2) + "\n", res, dir);
  writeAgentsSkills(root, dir, res);
  if (existsSync3(path3.join(dir, ".trod", "notes.md")) && notesLinked(trodPaths2(dir))) {
    const rule = linkAntigravityNotes2(trodPaths2(dir));
    if (rule === "written") res.written.push(ANTIGRAVITY_NOTES_RULE2);
    else if (rule === "exists") res.unchanged.push(ANTIGRAVITY_NOTES_RULE2);
    else if (typeof rule === "object") res.notes.push(rule.error);
  }
  addIgnores(dir, res);
  res.notes.push("trod forge and trod learn add .agents/rules/trod-notes.md, which loads .trod/notes.md into every Antigravity conversation.");
  if (opts.allowExec) res.notes.push("TROD_ALLOW_EXEC=1 is set in .agents/mcp_config.json: tool code runs outside the terminal sandbox. Antigravity still asks before each MCP tool call unless you allow it.");
  else res.notes.push("Tools do not run until TROD_ALLOW_EXEC=1 is set, and single-file tools are not even registered (re-run with --allow-exec).");
  return res;
}
var isTrodHook = (h) => h.type === "command" && typeof h.command === "string" && /^(npx -y trod(@\S+)? hook|node "[^"]*\/bin\/trod" hook)$/.test(h.command.trim());
function installedHookCommand(dir) {
  const hooks = readJson(path3.join(dir, ".claude", "settings.json")).hooks ?? {};
  for (const groups of Object.values(hooks)) for (const g of groups) for (const h of g.hooks ?? []) if (isTrodHook(h)) return h.command;
  return void 0;
}
function trodHookEvents(dir) {
  try {
    const hooks = readJson(path3.join(dir, ".claude", "settings.json")).hooks ?? {};
    return Object.entries(hooks).filter(([, groups]) => Array.isArray(groups) && groups.some((g) => (g.hooks ?? []).some(isTrodHook))).map(([event]) => event);
  } catch {
    return [];
  }
}
function installClaudeHooks(dir, hookCommand, res, opts = {}) {
  const settingsFile = path3.join(dir, ".claude", "settings.json");
  const settings = readJson(settingsFile);
  if (opts.approveMcp) settings.enableAllProjectMcpServers = true;
  const hooks = settings.hooks ?? {};
  const wanted = [["PostToolUse", "Write|Edit|MultiEdit"], ["SessionStart", void 0], ["UserPromptSubmit", void 0], ["SessionEnd", void 0]];
  for (const [event, matcher] of wanted) {
    const kept = (hooks[event] ?? []).map((g) => ({ ...g, hooks: g.hooks.filter((h) => !isTrodHook(h)) })).filter((g) => g.hooks.length > 0);
    kept.push({ ...matcher ? { matcher } : {}, hooks: [{ type: "command", command: hookCommand, timeout: event === "PostToolUse" ? 60 : 15 }] });
    hooks[event] = kept;
  }
  settings.hooks = hooks;
  writeIfChanged(settingsFile, JSON.stringify(settings, null, 2) + "\n", res, dir);
}
function writeAgentsSkills(root, dir, res) {
  for (const name of ["trod", "trod-learn"]) {
    const skill = path3.join(root, "agents", "skills", name, "SKILL.md");
    if (existsSync3(skill)) writeIfChanged(path3.join(dir, ".agents", "skills", name, "SKILL.md"), readFileSync3(skill, "utf8"), res, dir);
    else res.notes.push(`skill not found at ${skill}; skipped`);
  }
}
var TOML_BEGIN = "# >>> trod (managed by `trod init --codex`; edits inside this block are replaced)";
var TOML_END = "# <<< trod";
function codexConfigBlock(spec, opts) {
  const q = (v) => JSON.stringify(v);
  const env = { ...opts.env, ...opts.allowExec ? { TROD_ALLOW_EXEC: "1" } : {} };
  const lines2 = [TOML_BEGIN, "[mcp_servers.trod]", 'command = "npx"', `args = ["-y", ${q(spec)}, "mcp"]`, "startup_timeout_sec = 60", "tool_timeout_sec = 600"];
  if (opts.autoApprove) lines2.push('default_tools_approval_mode = "approve"');
  if (Object.keys(env).length) lines2.push("", "[mcp_servers.trod.env]", ...Object.entries(env).map(([k, v]) => `${k} = ${q(v)}`));
  if (!opts.featuresTable) lines2.push("", "# Tools written mid-session appear in the tool list (trod_run calls them either way).", "[features]", "mcp_tool_list_changed = true");
  lines2.push(TOML_END);
  return `${lines2.join("\n")}
`;
}
function initCodex(opts, root, spec, res) {
  const dir = opts.projectDir;
  if (opts.vendor) throw new Error("trod init --codex: --vendor is not supported yet (Codex starts project servers in the folder it runs in, which may be a subfolder)");
  const file = path3.join(dir, ".codex", "config.toml");
  const current = existsSync3(file) ? readFileSync3(file, "utf8") : "";
  const begin = current.indexOf(TOML_BEGIN);
  const end = current.indexOf(TOML_END, begin);
  const outside = begin >= 0 && end > begin ? current.slice(0, begin) + current.slice(end + TOML_END.length) : current;
  if (/^\s*\[\s*("?)mcp_servers\1\s*\.\s*("?)trod\2\s*(\.\s*("?)env\4\s*)?\]/m.test(outside)) throw new Error(`trod init --codex: ${path3.relative(dir, file)} already defines [mcp_servers.trod] outside trod's block; remove it and run again`);
  const previousEnv = {};
  if (begin >= 0 && end > begin) {
    const envPart = current.slice(begin, end).split("[mcp_servers.trod.env]")[1]?.split(/^\s*\[/m)[0] ?? "";
    for (const m of envPart.matchAll(/^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(?:"((?:[^"\\]|\\.)*)"|'([^']*)')/gm)) {
      if (m[3] !== void 0) previousEnv[m[1]] = m[3];
      else {
        try {
          previousEnv[m[1]] = JSON.parse(`"${m[2].replace(/\\U([0-9A-Fa-f]{8})/g, (_, h) => String.fromCodePoint(parseInt(h, 16)))}"`);
        } catch {
          previousEnv[m[1]] = m[2];
        }
      }
    }
  }
  const featuresTable = /^\s*\[\s*("?)features\1\s*\]/m.test(outside);
  const block = codexConfigBlock(spec, { allowExec: opts.allowExec, autoApprove: opts.autoApprove, env: previousEnv, featuresTable });
  const next = begin >= 0 && end > begin ? current.slice(0, begin) + block.trimEnd() + current.slice(end + TOML_END.length) : `${current}${current && !current.endsWith("\n") ? "\n" : ""}${current ? "\n" : ""}${block}`;
  writeIfChanged(file, next, res, dir);
  if (featuresTable && !/^\s*mcp_tool_list_changed\s*=\s*true/m.test(outside)) res.notes.push(`${path3.relative(dir, file)} has its own [features] table: add \`mcp_tool_list_changed = true\` to it so tools written mid-session appear in Codex's tool list.`);
  writeAgentsSkills(root, dir, res);
  if (existsSync3(path3.join(dir, ".trod", "notes.md")) && notesLinked(trodPaths2(dir))) {
    const notes = linkCodexNotes2(trodPaths2(dir));
    if (notes === "written") res.written.push(codexNotesFile2(trodPaths2(dir)));
    else if (notes === "exists") res.unchanged.push(codexNotesFile2(trodPaths2(dir)));
    else if (typeof notes === "object") res.notes.push(notes.error);
  }
  addIgnores(dir, res);
  res.notes.push("Codex loads .codex/config.toml only in trusted projects: trust this one when Codex asks (or with `codex --cd <repo>` once).");
  res.notes.push("trod forge, trod learn and trod notes --link keep a copy of .trod/notes.md in a block of AGENTS.md (Codex cannot import a file).");
  res.notes.push("Run Codex from the repository root or a folder inside it; trod finds the project by walking up to the nearest .trod/ folder.");
  if (opts.allowExec) res.notes.push("TROD_ALLOW_EXEC=1 is set in .codex/config.toml: tool code runs outside Codex's sandbox. Codex still applies its approval settings to MCP tool calls.");
  else res.notes.push("Tools do not run until TROD_ALLOW_EXEC=1 is set, and single-file tools are not even registered (re-run with --allow-exec).");
  if (opts.autoApprove) res.notes.push(`default_tools_approval_mode = "approve" is set for trod: Codex runs every trod tool, trod_eval's arbitrary code included, without asking.`);
  else res.notes.push("codex exec (approval policy never) refuses trod's tool calls until you approve them: rerun with --auto-approve to approve them all.");
  res.notes.push("trod forge and trod learn still run Claude Code (the `claude` CLI) as their engine; trod learn also reads your Codex sessions.");
  return res;
}
function addIgnores(dir, res) {
  const ignoreFile = path3.join(dir, ".gitignore");
  const ignore = existsSync3(ignoreFile) ? readFileSync3(ignoreFile, "utf8") : "";
  const missing = [".trod/tools/", ".trod/logs/"].filter((l) => !ignore.split(/\r?\n/).includes(l));
  if (missing.length) writeIfChanged(ignoreFile, `${ignore}${ignore && !ignore.endsWith("\n") ? "\n" : ""}# trod: per-session tools and logs (the library, notes and evidence ledger are committed)
${missing.join("\n")}
`, res, dir);
  else res.unchanged.push(".gitignore");
}

// packages/cli/src/report.ts
import { execFileSync } from "node:child_process";
import { readFileSync as readFileSync4 } from "node:fs";
import path4 from "node:path";
function lines(file) {
  const out = [];
  for (const l of readFileSync4(file, "utf8").split("\n")) {
    if (!l.trim()) continue;
    try {
      out.push(JSON.parse(l));
    } catch {
    }
  }
  return out;
}
var minutes = (a, b) => a && b ? Math.max(0, (Date.parse(b) - Date.parse(a)) / 6e4) : void 0;
function sessionMetrics(file) {
  const events = lines(file);
  if (!events.length) return void 0;
  const logged = events.find((e) => typeof e.sessionId === "string")?.sessionId;
  const id = typeof logged === "string" ? logged : path4.basename(file, ".jsonl");
  const m = { id, client: events[0].type === "session_meta" ? "codex" : "claude", turns: 0, toolCalls: 0, toolErrors: 0, followUps: 0, outputTokens: 0, inputTokens: 0, trodRun: false };
  const stamps = events.map((e) => e.timestamp).filter((t) => typeof t === "string");
  m.start = stamps[0];
  m.durationMin = minutes(stamps[0], stamps.at(-1));
  let prompts = 0;
  const prompt = (text) => {
    if (text.includes(LEARN_RUN_MARKER) || prompts === 0 && TROD_TASK.test(text)) m.trodRun = true;
    prompts++;
  };
  const usage = /* @__PURE__ */ new Map();
  if (m.client === "codex") {
    const failedMcp = codexFailedCalls(events);
    for (const e of events) {
      const p = e.payload ?? {};
      if (e.type === "event_msg" && p.type === "token_count" && p.info?.total_token_usage) {
        m.inputTokens = p.info.total_token_usage.input_tokens ?? m.inputTokens;
        m.outputTokens = p.info.total_token_usage.output_tokens ?? m.outputTokens;
      }
      if (e.type !== "response_item") continue;
      if (p.type === "message") {
        const text = (p.content ?? []).map((c) => c?.text ?? "").join("\n").trim();
        if (p.role === "user" && text.includes(LEARN_RUN_MARKER)) m.trodRun = true;
        if (p.role === "user" && text && !CODEX_WRAPPER.test(text)) prompt(text);
        else if (p.role === "assistant") m.turns++;
      } else if (p.type === "function_call" || p.type === "custom_tool_call") m.toolCalls++;
      else if ((p.type === "function_call_output" || p.type === "custom_tool_call_output") && (codexOutput(p.output).error || p.call_id !== void 0 && failedMcp.has(p.call_id))) m.toolErrors++;
    }
    m.toolErrors += codexUnmatchedFailures(events, failedMcp).length;
  } else {
    for (const e of events) {
      if (e.type === "user") {
        const content = e.message?.content;
        const texts = typeof content === "string" ? [content] : Array.isArray(content) ? content.filter((c) => c?.type === "text").map((c) => c.text ?? "") : [];
        if (texts.some((t) => t.includes(LEARN_RUN_MARKER))) m.trodRun = true;
      }
      if (e.isSidechain) continue;
      const msg = e.message;
      if (e.type === "user" && msg && !e.isMeta) {
        const blocks = typeof msg.content === "string" ? [{ type: "text", text: msg.content }] : msg.content ?? [];
        const typed = [];
        for (const c of blocks) {
          if (c?.type === "tool_result" && c.is_error) m.toolErrors++;
          else if (c?.type === "text" && c.text?.trim() && !CLAUDE_WRAPPER.test(c.text.trim())) typed.push(c.text.trim());
        }
        if (typed.length) prompt(typed.join("\n"));
      } else if (e.type === "assistant" && msg) {
        const key = msg.id ?? String(e.uuid);
        if (!usage.has(key)) m.turns++;
        usage.set(key, msg.usage ?? usage.get(key) ?? {});
        if (Array.isArray(msg.content)) m.toolCalls += msg.content.filter((c) => c?.type === "tool_use").length;
      }
    }
  }
  if (m.client === "claude") {
    for (const u of usage.values()) {
      m.outputTokens += u.output_tokens ?? 0;
      m.inputTokens += (u.input_tokens ?? 0) + (u.cache_read_input_tokens ?? 0) + (u.cache_creation_input_tokens ?? 0);
    }
  }
  if (!prompts && !m.turns) return void 0;
  m.followUps = Math.max(0, prompts - 1);
  return m;
}
function notesSince(projectDir) {
  const first = (needle, file) => {
    try {
      const out = execFileSync("git", ["log", "--reverse", "--format=%cI", `-S${needle}`, "--", file], { cwd: projectDir, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
      return out.split("\n").find(Boolean);
    } catch {
      return void 0;
    }
  };
  return { claude: first("@.trod/notes.md", "CLAUDE.md"), codex: first("<!-- trod notes -->", "AGENTS.md") };
}
var median = (xs) => {
  if (!xs.length) return 0;
  const s = [...xs].sort((a, b) => a - b);
  const mid = Math.floor(s.length / 2);
  return s.length % 2 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
};
function summarize(sessions) {
  const calls = sessions.reduce((n, s) => n + s.toolCalls, 0);
  return {
    sessions: sessions.length,
    turns: median(sessions.map((s) => s.turns)),
    toolCalls: median(sessions.map((s) => s.toolCalls)),
    errorRate: calls ? sessions.reduce((n, s) => n + s.toolErrors, 0) / calls : 0,
    followUps: median(sessions.map((s) => s.followUps)),
    outputTokens: median(sessions.map((s) => s.outputTokens)),
    inputTokens: median(sessions.map((s) => s.inputTokens)),
    durationMin: median(sessions.flatMap((s) => s.durationMin === void 0 ? [] : [s.durationMin]))
  };
}
function buildReport(all, since) {
  const sessions = all.filter((s) => !s.trodRun);
  const before = [];
  const after = [];
  let ungrouped = 0;
  for (const s of sessions) {
    const t = since[s.client];
    if (!t || !s.start) ungrouped++;
    else (Date.parse(s.start) >= Date.parse(t) ? after : before).push(s);
  }
  return { since, before: summarize(before), after: summarize(after), ungrouped, excludedTrodRuns: all.length - sessions.length };
}
function buildHoldoutReport(all, delivery) {
  const sessions = all.filter((s) => !s.trodRun);
  const holdout = [];
  const treated = [];
  let ungrouped = 0;
  for (const s of sessions) {
    const d = delivery.get(s.id);
    if (!d || !d.holdout && d.notes === false) ungrouped++;
    else (d.holdout ? holdout : treated).push(s);
  }
  return { mode: "holdout", since: {}, before: summarize(holdout), after: summarize(treated), ungrouped, excludedTrodRuns: all.length - sessions.length };
}
function formatReport(r, ledgerLine) {
  const out = [];
  const holdout = r.mode === "holdout";
  const since = holdout ? "hooks" : [r.since.claude && `Claude Code since ${r.since.claude.slice(0, 10)}`, r.since.codex && `Codex since ${r.since.codex.slice(0, 10)}`].filter(Boolean).join(", ");
  if (!holdout && !since) {
    out.push("No commit links the notes yet (the @.trod/notes.md import in CLAUDE.md, or the trod block in AGENTS.md), so there is no before and after to compare.");
    out.push(`${r.before.sessions + r.after.sessions + r.ungrouped} session(s) found${r.excludedTrodRuns ? `, besides ${r.excludedTrodRuns} trod forge/learn session(s)` : ""}.`);
    if (ledgerLine) out.push(`evidence: ${ledgerLine}`);
    return out.join("\n");
  }
  out.push(holdout ? "Sessions without notes (the holdout, chosen at random by trod's SessionStart hook) against sessions with them." : `Notes linked: ${since}.`);
  const rows = [
    ["sessions", (g) => g.sessions, (n) => String(n)],
    ["turns (median)", (g) => g.turns, (n) => n.toFixed(0)],
    ["tool calls (median)", (g) => g.toolCalls, (n) => n.toFixed(0)],
    ["failed tool calls", (g) => g.errorRate, (n) => `${(n * 100).toFixed(1)}%`],
    ["follow-up prompts (median)", (g) => g.followUps, (n) => n.toFixed(1)],
    ["output tokens (median)", (g) => g.outputTokens, (n) => Math.round(n).toLocaleString("en-US")],
    ["input tokens (median)", (g) => g.inputTokens, (n) => Math.round(n).toLocaleString("en-US")],
    ["duration, min (median)", (g) => g.durationMin, (n) => n.toFixed(1)]
  ];
  const w = Math.max(...rows.map(([l]) => l.length));
  out.push("", `${"".padEnd(w)}  ${(holdout ? "no notes" : "before").padStart(12)}  ${(holdout ? "with notes" : "after").padStart(12)}  change`);
  for (const [label, get, fmt] of rows) {
    const a = get(r.before);
    const b = get(r.after);
    const change = label === "sessions" || !r.before.sessions || !r.after.sessions || a === 0 ? "" : `${b >= a ? "+" : ""}${((b - a) / a * 100).toFixed(0)}%`;
    out.push(`${label.padEnd(w)}  ${fmt(a).padStart(12)}  ${fmt(b).padStart(12)}  ${change}`);
  }
  if (ledgerLine) out.push("", `evidence: ${ledgerLine}`);
  out.push("");
  if (r.excludedTrodRuns) out.push(`Left out: ${r.excludedTrodRuns} trod forge/learn session(s).`);
  if (r.ungrouped) out.push(holdout ? `Not compared: ${r.ungrouped} session(s) the hooks did not see (another client, or before hooks delivery).` : `Not compared: ${r.ungrouped} session(s) without a timestamp, or from a client whose notes were never linked in a commit.`);
  if (r.before.sessions < 10 || r.after.sessions < 10) out.push("Fewer than 10 sessions on one side: read the changes as anecdotes.");
  out.push(holdout ? "Randomized: which sessions got notes was decided by chance, so the tasks on both sides are alike. Lower is better on every row except sessions." : "Not a controlled experiment: the tasks before and after differ. Lower is better on every row except sessions. Hooks delivery (trod notes --delivery hooks) gives a randomized comparison.");
  return out.join("\n");
}

// packages/cli/src/delivery.ts
import { createHash } from "node:crypto";
import { appendFileSync, existsSync as existsSync4, mkdirSync as mkdirSync4, readdirSync as readdirSync3, readFileSync as readFileSync5, rmdirSync, statSync as statSync2, writeFileSync as writeFileSync4 } from "node:fs";
import path5 from "node:path";
import { notesPaths, readTrodConfig } from "../server/trod-lib.mjs";
var NOTES_LOG = "notes.jsonl";
function readWikiPages(paths) {
  const dir = path5.join(paths.trodDir, "wiki");
  if (!existsSync4(dir)) return [];
  const pages = [];
  for (const f of readdirSync3(dir).filter((f2) => f2.endsWith(".md")).sort()) {
    const raw = readFileSync5(path5.join(dir, f), "utf8");
    const m = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?/);
    const front = m?.[1] ?? "";
    const when = (front.match(/^when:\s*(.+)$/m)?.[1] ?? "").split(",").map((k) => k.trim().replace(/^["']|["']$/g, "").toLowerCase()).filter((k) => k.length >= 3);
    pages.push({ name: f.slice(0, -3), file: path5.join(dir, f), when, body: m ? raw.slice(m[0].length) : raw });
  }
  return pages;
}
function matchPages(pages, prompt) {
  const text = prompt.toLowerCase();
  const hits = [];
  for (const page of pages) {
    const keyword = page.when.find((k) => new RegExp(`(^|[^a-z0-9])${k.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}($|[^a-z0-9])`).test(text));
    if (keyword) hits.push({ page, keyword });
  }
  return hits;
}
function inHoldout(session, share) {
  if (!(share > 0)) return false;
  const n = parseInt(createHash("sha256").update(session).digest("hex").slice(0, 8), 16) / 4294967295;
  return n < Math.min(share, 0.5);
}
var stateFile = (paths, session) => path5.join(paths.trodDir, "state", "sessions", `${session.replace(/[^a-zA-Z0-9_-]/g, "_")}.json`);
function readState(paths, session) {
  try {
    return JSON.parse(readFileSync5(stateFile(paths, session), "utf8"));
  } catch {
    return void 0;
  }
}
function writeState(paths, session, state) {
  const file = stateFile(paths, session);
  ensureStateDir(paths.projectDir);
  mkdirSync4(path5.dirname(file), { recursive: true });
  writeFileSync4(file, JSON.stringify(state));
}
function log(paths, event) {
  try {
    mkdirSync4(paths.logsDir, { recursive: true });
    appendFileSync(path5.join(paths.logsDir, NOTES_LOG), `${JSON.stringify(event)}
`);
  } catch (e) {
    process.stderr.write(`trod: could not write ${NOTES_LOG}: ${e.message}
`);
  }
}
function withSessionLock(paths, session, fn) {
  const lock = `${stateFile(paths, session)}.lock`;
  mkdirSync4(path5.dirname(lock), { recursive: true });
  const deadline = Date.now() + 3e3;
  for (; ; ) {
    try {
      mkdirSync4(lock);
      break;
    } catch {
      try {
        if (Date.now() - statSync2(lock).mtimeMs > 5e3) rmdirSync(lock);
      } catch {
      }
      if (Date.now() > deadline) return fn();
      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 20);
    }
  }
  try {
    return fn();
  } finally {
    try {
      rmdirSync(lock);
    } catch {
    }
  }
}
function readNotesLog(paths) {
  const file = path5.join(paths.logsDir, NOTES_LOG);
  if (!existsSync4(file)) return [];
  const out = [];
  for (const line of readFileSync5(file, "utf8").split("\n")) {
    if (!line.trim()) continue;
    try {
      out.push(JSON.parse(line));
    } catch {
    }
  }
  return out;
}
var pageBlock = (page) => `trod: rules for this kind of task (.trod/wiki/${page.name}.md):

${page.body.trim()}`;
function notesHook(paths, payload, now = /* @__PURE__ */ new Date()) {
  const config = readTrodConfig(paths);
  if (config.delivery !== "hooks") return void 0;
  const session = payload.session_id;
  if (!session) return void 0;
  return withSessionLock(paths, session, () => deliver(paths, config.holdout ?? 0.1, session, payload, now));
}
function deliver(paths, share, session, payload, now) {
  const ts = now.toISOString();
  const start = payload.hook_event_name === "SessionStart";
  let state = readState(paths, session);
  const repeat = start && state?.started && now.getTime() - Date.parse(state.started) < 1e4 && (payload.source ?? "startup") === (state.source ?? "startup");
  if (repeat) return void 0;
  const blocks = [];
  if (start || !state) {
    const holdout = state?.holdout ?? inHoldout(session, share);
    const notesFile = notesPaths(paths).notes;
    const notes = !holdout && existsSync4(notesFile) ? readFileSync5(notesFile, "utf8").trim() : "";
    const fresh = !state;
    state = { holdout, pages: [], started: start ? ts : void 0, source: start ? payload.source ?? "startup" : void 0 };
    writeState(paths, session, state);
    if (fresh) log(paths, { type: "session", ts, session, holdout, notes: !!notes });
    if (notes) blocks.push(`trod: verified notes about this project (.trod/notes.md):

${notes}`);
    if (start) return blocks[0];
  }
  if (payload.hook_event_name === "UserPromptSubmit" && !state.holdout && payload.prompt) {
    const seen = state.pages;
    const hits = matchPages(readWikiPages(paths), payload.prompt).filter((h) => !seen.includes(h.page.name));
    if (hits.length) {
      for (const h of hits) log(paths, { type: "page", ts, session, page: h.page.name, trigger: h.keyword });
      writeState(paths, session, { ...state, pages: [...seen, ...hits.map((h) => h.page.name)] });
      blocks.push(...hits.map((h) => pageBlock(h.page)));
    }
  }
  return blocks.length ? blocks.join("\n\n---\n\n") : void 0;
}
function sessionDelivery(paths) {
  const out = /* @__PURE__ */ new Map();
  for (const e of readNotesLog(paths)) {
    if (e.type === "session") out.set(e.session, { holdout: e.holdout, notes: e.notes, pages: out.get(e.session)?.pages ?? [] });
    else if (e.type === "page") {
      const s = out.get(e.session) ?? { holdout: false, notes: false, pages: [] };
      if (!s.pages.includes(e.page)) s.pages.push(e.page);
      out.set(e.session, s);
    }
  }
  return out;
}

// packages/cli/src/tune.ts
import { spawn as spawn2, spawnSync } from "node:child_process";
import { cpSync, existsSync as existsSync5, mkdirSync as mkdirSync5, mkdtempSync as mkdtempSync2, readFileSync as readFileSync6, rmSync as rmSync2, writeFileSync as writeFileSync5 } from "node:fs";
import { tmpdir as tmpdir2 } from "node:os";
import { createHash as createHash2 } from "node:crypto";
import path6 from "node:path";
import { NOTES_IMPORT as NOTES_IMPORT2, NOTES_MAX_CHARS as NOTES_MAX_CHARS2, trodPaths as trodPaths3, verifyNotes as verifyNotes2 } from "../server/trod-lib.mjs";
var TUNE_CONFIG = path6.join(".trod", "tune.json");
var TUNE_DIR = path6.join(".trod", "tune");
var DEFAULT_TUNE_MODEL = "claude-haiku-5-5";
var DEFAULT_TUNE_PROPOSER = "claude-opus-5-5";
var HARNESS_FILES = ["notes.md", "notes.checks.json", "wiki", "library"];
function readTuneConfig(file) {
  if (!existsSync5(file)) throw new Error(`no ${file}: list tasks there as {"tasks": [{"id", "prompt", "check"}]} (see docs/reference.md, "Tuning notes")`);
  let raw;
  try {
    raw = JSON.parse(readFileSync6(file, "utf8"));
  } catch (e) {
    throw new Error(`${file}: not valid JSON (${e.message})`);
  }
  const c = raw;
  if (!c || !Array.isArray(c.tasks) || c.tasks.length < 2) throw new Error(`${file}: needs "tasks" with at least 2 tasks (some to practise on, some to validate with)`);
  const ids = /* @__PURE__ */ new Set();
  for (const [i, t] of c.tasks.entries()) {
    for (const k of ["id", "prompt", "check"]) if (typeof t?.[k] !== "string" || !t[k].trim()) throw new Error(`${file}: tasks[${i}] needs a non-empty "${k}"`);
    if (t.setup !== void 0 && typeof t.setup !== "string") throw new Error(`${file}: tasks[${i}].setup must be a shell command`);
    if (t.split !== void 0 && t.split !== "practice" && t.split !== "validate") throw new Error(`${file}: tasks[${i}].split must be "practice" or "validate"`);
    if (ids.has(t.id)) throw new Error(`${file}: duplicate task id "${t.id}"`);
    if (!/^[A-Za-z0-9._-]+$/.test(t.id)) throw new Error(`${file}: task id "${t.id}" may only use letters, digits, ".", "_" and "-"`);
    ids.add(t.id);
  }
  for (const k of ["runs", "margin", "iterations", "parallel", "timeoutMinutes"]) {
    const v = c[k];
    if (v !== void 0 && (!Number.isInteger(v) || v < (k === "margin" ? 0 : 1))) throw new Error(`${file}: "${k}" must be a whole number${k === "margin" ? "" : " \u2265 1"}`);
  }
  return c;
}
function splitTasks(tasks) {
  const practice = [];
  const validate = [];
  const free = [];
  for (const t of tasks) (t.split === "practice" ? practice : t.split === "validate" ? validate : free).push(t);
  for (const t of free) (parseInt(createHash2("sha256").update(t.id).digest("hex").slice(0, 8), 16) % 2 ? validate : practice).push(t);
  const movable = (from) => from.findIndex((t) => !t.split);
  if (!practice.length && movable(validate) >= 0) practice.push(...validate.splice(movable(validate), 1));
  if (!validate.length && movable(practice) >= 0) validate.push(...practice.splice(movable(practice), 1));
  if (!practice.length || !validate.length) throw new Error("trod tune needs at least one practice task and one validation task");
  return { practice, validate };
}
function snapshotHarness(trodDir, dest) {
  mkdirSync5(dest, { recursive: true });
  for (const f of HARNESS_FILES) if (existsSync5(path6.join(trodDir, f))) cpSync(path6.join(trodDir, f), path6.join(dest, f), { recursive: true });
}
function isGitRepo(dir) {
  return spawnSync("git", ["-C", dir, "rev-parse", "--verify", "HEAD"], { stdio: "ignore" }).status === 0;
}
function makeWorkspace(projectDir, harness, scratch, hide = [TUNE_CONFIG]) {
  mkdirSync5(scratch, { recursive: true });
  const dir = mkdtempSync2(path6.join(scratch, "ws-"));
  const remove = () => rmSync2(dir, { recursive: true, force: true });
  const git = isGitRepo(projectDir);
  if (git) {
    const r = spawnSync("sh", ["-c", 'git -C "$1" archive HEAD | tar -x -C "$2"', "sh", projectDir, dir], { stdio: "ignore" });
    if (r.status !== 0) throw new Error(`could not export HEAD of ${projectDir} (git archive)`);
  } else {
    const skip = /* @__PURE__ */ new Set([".git", "node_modules"]);
    cpSync(projectDir, dir, { recursive: true, filter: (src) => !skip.has(path6.basename(src)) && !src.startsWith(path6.join(projectDir, TUNE_DIR)) && !src.startsWith(path6.resolve(scratch)) });
  }
  const trodDir = path6.join(dir, ".trod");
  for (const f of HARNESS_FILES) rmSync2(path6.join(trodDir, f), { recursive: true, force: true });
  snapshotHarness(harness, trodDir);
  for (const h of hide) rmSync2(path6.join(dir, h), { recursive: true, force: true });
  const claudeMd = path6.join(dir, "CLAUDE.md");
  const text = existsSync5(claudeMd) ? readFileSync6(claudeMd, "utf8") : "";
  if (existsSync5(path6.join(trodDir, "notes.md")) && !text.split("\n").some((l) => l.trim() === NOTES_IMPORT2)) writeFileSync5(claudeMd, `${text.trimEnd()}${text ? "\n\n" : ""}${NOTES_IMPORT2}
`);
  if (git) {
    const g = (...a) => spawnSync("git", ["-C", dir, ...a], { stdio: "ignore" });
    g("init", "-q");
    g("add", "-A");
    g("-c", "user.name=trod", "-c", "user.email=trod@localhost", "commit", "-q", "-m", "base");
  }
  return { dir, remove };
}
function hiddenPaths(projectDir, configFile) {
  const hide = [TUNE_CONFIG];
  if (configFile) {
    const rel = path6.relative(projectDir, path6.resolve(configFile));
    if (rel && rel !== ".." && !rel.startsWith(`..${path6.sep}`) && !path6.isAbsolute(rel)) hide.push(rel);
  }
  return hide;
}
function sh(cmd, cwd, env, timeoutMs) {
  const r = spawnSync("sh", ["-c", cmd], { cwd, env, encoding: "utf8", timeout: timeoutMs, maxBuffer: 16 * 1024 * 1024 });
  return { code: r.status, output: `${r.stdout ?? ""}${r.stderr ?? ""}`.slice(-2e3) };
}
async function runTask(ctx, harness, task, run, outDir) {
  const stream = path6.join(outDir, `${task.id}-${run}.jsonl`);
  const ws = makeWorkspace(ctx.projectDir, harness, ctx.scratch, ctx.hide);
  try {
    const env = { ...ctx.env, [TROD_SESSION_ENV]: "tune", TROD_ALLOW_EXEC: "1", TROD_PROJECT_DIR: ws.dir };
    delete env.CLAUDECODE;
    if (task.setup) {
      const s = sh(task.setup, ws.dir, env, 10 * 6e4);
      if (s.code !== 0) return { task: task.id, run, pass: false, stream, error: `setup exited ${s.code}: ${s.output.trim().split("\n").at(-1) ?? ""}` };
    }
    const args = ["-p", task.prompt, "--output-format", "stream-json", "--verbose", "--mcp-config", ctx.mcpConfig, "--strict-mcp-config", "--allowedTools", "Bash,Read,Write,Edit,Glob,Grep,TodoWrite,mcp__trod__*", "--disallowedTools", "WebFetch,WebSearch,Task,Agent", "--model", ctx.config.model, "--max-budget-usd", ctx.config.maxBudgetUsd ?? "2"];
    const { code, text, spawnError } = await new Promise((resolve) => {
      const child = spawn2(ctx.claudeBin ?? ctx.env.TROD_CLAUDE_BIN ?? "claude", args, { cwd: ws.dir, env, stdio: ["ignore", "pipe", "pipe"] });
      let buf = "";
      child.stdout.setEncoding("utf8");
      child.stdout.on("data", (c) => buf += c);
      child.stderr.resume();
      const timer = setTimeout(() => child.kill("SIGKILL"), ctx.config.timeoutMinutes * 6e4);
      child.on("close", (c) => {
        clearTimeout(timer);
        resolve({ code: c, text: buf });
      });
      child.on("error", (err) => resolve({ code: null, text: buf, spawnError: err.message }));
    });
    writeFileSync5(stream, text);
    const result = lastResultEvent(text);
    if (code === null || !result) return { task: task.id, run, pass: false, stream, costUsd: result?.total_cost_usd, error: spawnError ? `could not start the session: ${spawnError}` : code === null ? "session killed (timeout)" : "session ended without a result" };
    const check = sh(task.check, ws.dir, env, 10 * 6e4);
    return { task: task.id, run, pass: check.code === 0, stream, costUsd: result.total_cost_usd };
  } finally {
    ws.remove();
  }
}
async function runBatch(ctx, harness, tasks, outDir, label) {
  mkdirSync5(outDir, { recursive: true });
  const jobs = tasks.flatMap((t) => Array.from({ length: ctx.config.runs }, (_, i) => [t, i + 1]));
  const results = [];
  let next = 0;
  await Promise.all(
    Array.from({ length: Math.min(ctx.config.parallel, jobs.length) }, async () => {
      while (next < jobs.length) {
        const [t, n] = jobs[next++];
        const r = await runTask(ctx, harness, t, n, outDir).catch((err) => ({ task: t.id, run: n, pass: false, stream: "", error: err.message.split("\n")[0] }));
        results.push(r);
        ctx.out(`  ${label} ${r.pass ? "pass" : r.error ? "ERROR" : "fail"} ${t.id}#${n}${r.error ? ` (${r.error})` : ""}`);
      }
    })
  );
  writeFileSync5(path6.join(outDir, "results.json"), JSON.stringify(results, null, 2));
  return results;
}
var passed = (rs) => rs.filter((r) => r.pass).length;
var TUNE_PROMPT = (model, sessionsDir, failed, total) => `You are tuning notes. You are not solving a task: you are rewriting the notes that ${model} sessions in this project load (.trod/notes.md, and the pages in .trod/wiki/ it points to), so that they pass tasks like the ones below.

${sessionsDir} holds digests of ${total} practice sessions that ran with the current notes: ${failed} failed the task's check, the rest passed. Each digest has the task prompt, the check, the steps the session took and how it ended.

1. Read the current notes, then every failed digest, then a few passed ones.
2. For each failure, find what the session did not know or did wrong, and what in this project would have told it (look at the files, run commands, try things).
3. Rewrite .trod/notes.md (and .trod/wiki/ pages if they help): general rules about this project that hold for unseen tasks of this kind. Never task-specific answers, file contents or "for task X do Y". Keep every current rule unless the sessions show it is wrong. At most ${NOTES_MAX_CHARS2} characters in .trod/notes.md.
4. Keep .trod/notes.checks.json consistent: every check must still pass; add checks for new claims you can verify with a trod tool.
Do not change anything outside .trod/. When the notes are written, reply DONE with one line per rule you added or changed.`;
async function propose(ctx, harness, practice, tasks, dir) {
  const ws = makeWorkspace(ctx.projectDir, harness, ctx.scratch, ctx.hide);
  try {
    const sessions = path6.join(ws.dir, ".trod", "tune-sessions");
    mkdirSync5(sessions, { recursive: true });
    const byId = new Map(tasks.map((t) => [t.id, t]));
    for (const r of practice) {
      if (r.error) continue;
      const t = byId.get(r.task);
      const d = existsSync5(r.stream) ? digestTranscript(r.stream, { outcome: r.pass ? "pass" : "fail", task: t.prompt, maxChars: 6e3 }) : void 0;
      writeFileSync5(path6.join(sessions, `${r.pass ? "pass" : "FAIL"}-${r.task}-${r.run}.md`), `# ${r.pass ? "PASSED" : "FAILED"}: ${r.task} (run ${r.run})

Check: \`${t.check}\`

${d?.text ?? "(no transcript)"}
`);
    }
    const before = existsSync5(path6.join(ws.dir, ".trod", "notes.md")) ? readFileSync6(path6.join(ws.dir, ".trod", "notes.md"), "utf8") : "";
    const scored = practice.filter((r) => !r.error);
    const res = await forge({
      projectDir: ws.dir,
      brief: `Practice session digests: ${path6.relative(ws.dir, sessions)}/ (FAIL-*.md failed, pass-*.md passed).`,
      prompt: TUNE_PROMPT(ctx.config.model, path6.relative(ws.dir, sessions), scored.filter((r) => !r.pass).length, scored.length),
      model: ctx.config.proposer ?? DEFAULT_TUNE_PROPOSER,
      maxBudgetUsd: "5",
      linkNotes: false,
      claudeBin: ctx.claudeBin,
      env: { ...ctx.env, [TROD_SESSION_ENV]: "tune" },
      streamFile: path6.join(dir, "proposer.jsonl"),
      out: ctx.out
    });
    rmSync2(sessions, { recursive: true, force: true });
    if (res.exitCode !== 0) return { reason: `the proposer session failed (exit ${res.exitCode})`, costUsd: res.costUsd };
    const after = existsSync5(path6.join(ws.dir, ".trod", "notes.md")) ? readFileSync6(path6.join(ws.dir, ".trod", "notes.md"), "utf8") : "";
    if (!after.trim() || after === before) return { reason: "the proposer did not change .trod/notes.md", costUsd: res.costUsd };
    const report = await verifyNotes2(trodPaths3(ws.dir), { execAllowed: true, env: ctx.env });
    if (report.checks.some((c) => !c.ok) || report.errors.length) return { reason: `the candidate's notes checks fail: ${[...report.checks.filter((c) => !c.ok).map((c) => c.claim), ...report.errors].join("; ")}`, costUsd: res.costUsd };
    const candidate = path6.join(dir, "candidate");
    snapshotHarness(path6.join(ws.dir, ".trod"), candidate);
    return { candidate, costUsd: res.costUsd };
  } finally {
    ws.remove();
  }
}
async function tune(opts) {
  const out = opts.out ?? (() => {
  });
  const config = { model: DEFAULT_TUNE_MODEL, runs: 2, parallel: 3, timeoutMinutes: 15, ...opts.config };
  const margin = config.margin ?? 1;
  const scratch = mkdtempSync2(path6.join(tmpdir2(), "trod-tune-"));
  const ctx = { projectDir: opts.projectDir, out, claudeBin: opts.claudeBin, env: opts.env ?? process.env, config, scratch, hide: hiddenPaths(opts.projectDir, opts.configFile), mcpConfig: path6.join(scratch, "mcp.json") };
  writeFileSync5(ctx.mcpConfig, JSON.stringify({ mcpServers: { trod: { command: process.execPath, args: [defaultServerPath()] } } }));
  const { practice, validate } = splitTasks(config.tasks);
  const outDir = opts.outDir ?? path6.join(opts.projectDir, TUNE_DIR, (/* @__PURE__ */ new Date()).toISOString().replace(/[:.]/g, "-"));
  mkdirSync5(outDir, { recursive: true });
  const ignore = path6.join(opts.projectDir, TUNE_DIR, ".gitignore");
  if (existsSync5(path6.dirname(ignore)) && !existsSync5(ignore)) writeFileSync5(ignore, "*\n");
  const trodDir = path6.join(opts.projectDir, ".trod");
  let harness = path6.join(outDir, "harness-0");
  snapshotHarness(trodDir, harness);
  out(`tuning notes for ${config.model}: ${practice.length} practice task(s), ${validate.length} validation task(s), ${config.runs} run(s) each`);
  const iterations = [];
  let cost = 0;
  let accepted = false;
  const add = (rs) => rs.reduce((a, r) => a + (r.costUsd ?? 0), 0);
  try {
    for (let it = 1; it <= (config.iterations ?? 1); it++) {
      const dir = path6.join(outDir, `iteration-${it}`);
      out(`iteration ${it}: practice`);
      const prac = await runBatch(ctx, harness, practice, path6.join(dir, "practice"), "practice");
      cost += add(prac);
      const errors = prac.filter((r) => r.error).length;
      const rec = { iteration: it, practice: { passed: passed(prac), runs: prac.length, errors }, accepted: false };
      iterations.push(rec);
      if (errors === prac.length) {
        rec.reason = "every practice run errored (setup, timeout or no result): fix the tasks first";
        out(`  ${rec.reason}`);
        break;
      }
      if (passed(prac) === prac.length - errors) {
        rec.reason = "every practice run passed: nothing to learn from";
        out(`  ${rec.reason}`);
        break;
      }
      out(`iteration ${it}: proposing (${prac.length - errors - passed(prac)} failed run(s) to learn from)`);
      const prop = await propose(ctx, harness, prac, config.tasks, dir);
      cost += prop.costUsd ?? 0;
      if (!prop.candidate) {
        rec.reason = prop.reason;
        out(`  no candidate: ${prop.reason}`);
        continue;
      }
      rec.proposal = prop.candidate;
      out(`iteration ${it}: validating`);
      const parent = await runBatch(ctx, harness, validate, path6.join(dir, "validate-current"), "current");
      const cand = await runBatch(ctx, prop.candidate, validate, path6.join(dir, "validate-candidate"), "candidate");
      cost += add(parent) + add(cand);
      const bad = new Set([...parent, ...cand].filter((r) => r.error).map((r) => `${r.task}#${r.run}`));
      const keep = (rs) => rs.filter((r) => !bad.has(`${r.task}#${r.run}`));
      rec.parent = { passed: passed(keep(parent)), runs: keep(parent).length };
      rec.candidate = { passed: passed(keep(cand)), runs: keep(cand).length };
      rec.accepted = rec.candidate.runs > 0 && rec.candidate.passed >= rec.parent.passed + margin;
      out(`  ${rec.accepted ? "ACCEPT" : "reject"}: current notes ${rec.parent.passed}/${rec.parent.runs}, candidate ${rec.candidate.passed}/${rec.candidate.runs} (needs +${margin})${bad.size ? `; ${bad.size} errored run(s) left out` : ""}`);
      if (rec.accepted) {
        harness = prop.candidate;
        accepted = true;
      }
    }
    if (accepted) {
      for (const f of HARNESS_FILES) rmSync2(path6.join(trodDir, f), { recursive: true, force: true });
      snapshotHarness(harness, trodDir);
      out(`updated .trod/notes.md${existsSync5(path6.join(harness, "wiki")) ? " and .trod/wiki/" : ""} with the winning candidate; review and commit them`);
    } else out("notes unchanged");
  } finally {
    rmSync2(ctx.scratch, { recursive: true, force: true });
  }
  const result = { iterations, accepted, outDir, costUsd: cost };
  writeFileSync5(path6.join(outDir, "state.json"), JSON.stringify(result, null, 2));
  out(`run transcripts, candidates and the decision: ${path6.relative(opts.projectDir, outDir)} ($${cost.toFixed(2)})`);
  return result;
}

// packages/cli/src/autolearn.ts
import { spawn as spawn3 } from "node:child_process";
import { appendFileSync as appendFileSync2, closeSync as closeSync2, existsSync as existsSync6, mkdirSync as mkdirSync6, openSync as openSync2, readFileSync as readFileSync7, writeFileSync as writeFileSync6 } from "node:fs";
import path7 from "node:path";
import { readTrodConfig as readTrodConfig2, writeTrodConfig } from "../server/trod-lib.mjs";
var INBOX_FILE = path7.join(LEARN_STATE_DIR, "inbox.jsonl");
var AUTO_STATE_FILE = path7.join(LEARN_STATE_DIR, "auto-learn.json");
var AUTO_LOG = path7.join(".trod", "logs", "auto-learn.log");
function autoLearnConfig(paths) {
  const a = readTrodConfig2(paths).autoLearn;
  return a && Number.isInteger(a.after) && a.after >= 1 ? a : void 0;
}
function setAutoLearn(paths, value) {
  const config = readTrodConfig2(paths);
  if (value === "off") {
    const { autoLearn: _, ...rest } = config;
    writeTrodConfig(paths, rest);
    return { ok: true, message: "automatic learning is off" };
  }
  const n = Number(value);
  if (!Number.isInteger(n) || n < 1) return { ok: false, message: '--auto takes a number of sessions (e.g. 10) or "off"' };
  const cooldownHours = config.autoLearn?.cooldownHours ?? 6;
  writeTrodConfig(paths, { ...config, autoLearn: { after: n, cooldownHours } });
  return { ok: true, message: `automatic learning is on: trod's SessionEnd hook starts \`trod learn\` in the background after every ${n} finished session(s) (at most once per ${cooldownHours} hours, at most $${config.autoLearn?.budgetUsd ?? 2} each; log: ${AUTO_LOG}). It needs trod's hooks (trod init or the plugin). Commit .trod/config.json to turn it on for everyone, or keep it local.` };
}
function readInbox(paths) {
  const file = path7.join(paths.projectDir, INBOX_FILE);
  if (!existsSync6(file)) return [];
  const out = [];
  for (const line of readFileSync7(file, "utf8").split("\n")) {
    if (!line.trim()) continue;
    try {
      out.push(JSON.parse(line));
    } catch {
    }
  }
  return out;
}
function pendingSessions(paths) {
  const state = readLearnState(paths.projectDir);
  const learned = new Set(state.sessions);
  const since = state.lastRun ? Date.parse(state.lastRun) : 0;
  return [...new Set(readInbox(paths).filter((e) => Date.parse(e.endedAt) > since && !learned.has(e.session)).map((e) => e.session))];
}
function spawnLearn(paths, cli = process.argv[1], env = process.env) {
  const budget = String(autoLearnConfig(paths)?.budgetUsd ?? 2);
  const log2 = path7.join(paths.projectDir, AUTO_LOG);
  mkdirSync6(path7.dirname(log2), { recursive: true });
  appendFileSync2(log2, `
=== ${(/* @__PURE__ */ new Date()).toISOString()} automatic trod learn ===
`);
  const fd = openSync2(log2, "a");
  const childEnv = { ...env, [TROD_SESSION_ENV]: "learn" };
  delete childEnv.CLAUDECODE;
  const child = spawn3(process.execPath, [cli, "learn", "--dir", paths.projectDir, "--budget", budget], { cwd: paths.projectDir, env: childEnv, detached: true, stdio: ["ignore", fd, fd] });
  child.unref();
  closeSync2(fd);
}
function sessionEndHook(paths, payload, start = (p) => spawnLearn(p), now = /* @__PURE__ */ new Date(), env = process.env) {
  const config = autoLearnConfig(paths);
  if (!config) return { recorded: false, pending: 0, started: false, reason: "automatic learning is off" };
  if (env[TROD_SESSION_ENV]) return { recorded: false, pending: 0, started: false, reason: `a session trod started (${env[TROD_SESSION_ENV]})` };
  if (!payload.session_id) return { recorded: false, pending: 0, started: false, reason: "no session id" };
  ensureStateDir(paths.projectDir);
  appendFileSync2(path7.join(paths.projectDir, INBOX_FILE), `${JSON.stringify({ session: payload.session_id, transcript: payload.transcript_path, endedAt: now.toISOString() })}
`);
  const pending = pendingSessions(paths).length;
  if (pending < config.after) return { recorded: true, pending, started: false, reason: `${pending}/${config.after} sessions since the last learning run` };
  const stateFile2 = path7.join(paths.projectDir, AUTO_STATE_FILE);
  let last = 0;
  try {
    last = Date.parse(JSON.parse(readFileSync7(stateFile2, "utf8")).lastStarted ?? "") || 0;
  } catch {
  }
  const cooldown = (config.cooldownHours ?? 6) * 36e5;
  if (now.getTime() - last < cooldown) return { recorded: true, pending, started: false, reason: "cooldown since the last automatic run" };
  if (learnLockHeld(paths.projectDir)) return { recorded: true, pending, started: false, reason: "a learning run is in progress" };
  writeFileSync6(stateFile2, JSON.stringify({ lastStarted: now.toISOString(), pending }));
  start(paths);
  return { recorded: true, pending, started: true };
}

// packages/cli/src/doctor.ts
import { spawnSync as spawnSync2 } from "node:child_process";
import { existsSync as existsSync7, readdirSync as readdirSync4, readFileSync as readFileSync8 } from "node:fs";
import path8 from "node:path";
import { listToolEntries, notesLinked as notesLinked2, notesPaths as notesPaths2, readChecks, readTrodConfig as readTrodConfig3, NOTES_MAX_CHARS as NOTES_MAX_CHARS3 } from "../server/trod-lib.mjs";
var HOOK_EVENTS = ["PostToolUse", "SessionStart", "UserPromptSubmit", "SessionEnd"];
function execEnabled(projectDir, env = process.env) {
  if (env.TROD_ALLOW_EXEC === "1") return true;
  const entry = (file) => readJson2(file)?.mcpServers?.trod;
  if (entry(path8.join(projectDir, ".mcp.json"))?.env?.TROD_ALLOW_EXEC === "1") return true;
  if (entry(path8.join(projectDir, ".agents", "mcp_config.json"))?.env?.TROD_ALLOW_EXEC === "1") return true;
  const codex = path8.join(projectDir, ".codex", "config.toml");
  return existsSync7(codex) && /^\s*TROD_ALLOW_EXEC\s*=\s*"1"/m.test(readFileSync8(codex, "utf8"));
}
function readJson2(file) {
  try {
    const v = JSON.parse(readFileSync8(file, "utf8"));
    return v && typeof v === "object" ? v : void 0;
  } catch {
    return void 0;
  }
}
function defaultClaudeVersion(env) {
  const r = spawnSync2(env.TROD_CLAUDE_BIN ?? "claude", ["--version"], { encoding: "utf8", timeout: 1e4 });
  return r.status === 0 ? r.stdout.trim().split("\n")[0] : void 0;
}
function doctor(paths, opts = {}) {
  const env = opts.env ?? process.env;
  const dir = paths.projectDir;
  const setup = [];
  const knowledge = [];
  const sessions = [];
  const claude = (opts.claudeVersion ?? (() => defaultClaudeVersion(env)))();
  setup.push(claude ? { level: "ok", text: `Claude Code CLI: ${claude}` } : { level: "warn", text: "Claude Code CLI not found (`claude`): trod learn, forge and tune need it; the MCP server and hooks do not" });
  const mcp = readJson2(path8.join(dir, ".mcp.json"));
  const server = mcp?.mcpServers?.trod;
  const antigravity = readJson2(path8.join(dir, ".agents", "mcp_config.json"))?.mcpServers?.trod;
  const codexFile = path8.join(dir, ".codex", "config.toml");
  const codex = existsSync7(codexFile) && /^\s*\[\s*mcp_servers\s*\.\s*trod\s*\]/m.test(readFileSync8(codexFile, "utf8"));
  const clients = [server && "Claude Code (.mcp.json)", antigravity && "Antigravity (.agents/mcp_config.json)", codex && "Codex (.codex/config.toml)"].filter(Boolean);
  const installed = clients.length > 0;
  setup.push(
    installed ? { level: "ok", text: `MCP server set up for ${clients.join(", ")}` } : { level: "info", text: "No trod server in this repository's config (fine if you use the Claude Code plugin; otherwise run `trod init`)" }
  );
  const settingsFile = path8.join(dir, ".claude", "settings.json");
  const hooks = trodHookEvents(dir);
  const missing = HOOK_EVENTS.filter((e) => !hooks.includes(e));
  if (existsSync7(settingsFile) && !readJson2(settingsFile)) setup.push({ level: "bad", text: ".claude/settings.json is not valid JSON: Claude Code ignores it, hooks included" });
  else if (!hooks.length) setup.push({ level: "info", text: "No trod hooks in .claude/settings.json (the plugin brings its own; `trod init` installs them for every session, cloud ones included)" });
  else if (missing.length) setup.push({ level: "warn", text: `Hooks: ${hooks.join(", ")} installed, ${missing.join(", ")} missing (an older trod wrote them: run \`trod init\` again)` });
  else setup.push({ level: "ok", text: "Hooks installed: tool validation, notes delivery, session counting" });
  const execOn = execEnabled(dir, env);
  setup.push(
    execOn ? { level: "ok", text: "Tools may run (TROD_ALLOW_EXEC=1): their code runs outside the client's permission prompts" } : { level: "info", text: "Tools do not run in sessions (TROD_ALLOW_EXEC is not set). Notes work without it; for tools, see `trod help init`" }
  );
  const np = notesPaths2(paths);
  const hasNotes = existsSync7(np.notes);
  const linked = hasNotes && notesLinked2(paths);
  const config = readTrodConfig3(paths);
  if (hasNotes) {
    const chars = readFileSync8(np.notes, "utf8").length;
    const { checks, errors } = readChecks(np.checks);
    const how = linked ? config.delivery === "hooks" ? `delivered by trod's hooks${config.holdout ? ` (${Math.round(config.holdout * 100)}% holdout)` : ""}` : "linked from CLAUDE.md" : "NOT linked: sessions do not load them";
    knowledge.push({ level: linked ? chars > NOTES_MAX_CHARS3 ? "warn" : "ok" : "warn", text: `Notes: ${chars.toLocaleString("en-US")} chars${chars > NOTES_MAX_CHARS3 ? ` (over ${NOTES_MAX_CHARS3}: every session pays for them, trim them)` : ""}, ${how}` });
    if (errors.length) knowledge.push({ level: "bad", text: `Note checks: ${errors[0]}${errors.length > 1 ? ` (and ${errors.length - 1} more)` : ""}` });
    else knowledge.push({ level: "info", text: checks.length ? `Note checks: ${checks.length} (run them with \`trod verify\`)` : "Note checks: none (the notes rest on the sessions they were learned from)" });
  } else knowledge.push({ level: "info", text: "No notes yet (.trod/notes.md)" });
  const wikiDir = path8.join(paths.trodDir, "wiki");
  const pages = existsSync7(wikiDir) ? readdirSync4(wikiDir).filter((f) => f.endsWith(".md")).length : 0;
  if (pages) knowledge.push({ level: "ok", text: `Wiki: ${pages} page(s) for particular kinds of task` });
  const library = listToolEntries(paths.libraryDir).length;
  const sessionTools = listToolEntries(paths.toolsDir).length;
  if (library && !execOn) knowledge.push({ level: "warn", text: `Tools: ${library} in the library, but sessions cannot run them (execution is off; \`trod init --allow-exec\` turns it on, see \`trod help init\`)` });
  else if (library || sessionTools) knowledge.push({ level: library ? "ok" : "info", text: `Tools: ${library} in the library${sessionTools ? `, ${sessionTools} session tool(s) not promoted` : ""}` });
  const ledger = readLedger(dir);
  if (ledger.exists) knowledge.push(ledger.errors.length ? { level: "bad", text: `Evidence ledger: ${ledger.errors[0]}` } : { level: "ok", text: `Evidence: ${summarizeLedger(ledger.rules)}` });
  const files = (opts.transcripts ?? (() => findTranscripts([transcriptDir(dir), ...codexTranscripts(dir)])))();
  const state = readLearnState(dir);
  const CAP = 200;
  const { picked, skipped } = pickSessions(files, { seen: new Set(state.sessions), limit: CAP });
  const pending = picked.length;
  const last = state.lastRun ? ` (last learning run: ${state.lastRun.slice(0, 10)})` : "";
  sessions.push({
    level: "info",
    text: pending || skipped ? `${pending}${pending === CAP ? "+" : ""} session(s) to learn from, ${skipped} already learned from${last}` : "No sessions of this project to learn from yet (Claude Code and Codex keep transcripts as you work)"
  });
  const auto = autoLearnConfig(paths);
  sessions.push({ level: "info", text: auto ? `Learning by itself: after every ${auto.after} session(s)` : "Learning by itself: off (`trod learn --auto 10` turns it on)" });
  const broken = [...setup, ...knowledge, ...sessions].some((f) => f.level === "bad");
  let next;
  if (broken) next = "Fix what is marked \u2717 above first.";
  else if (!installed && !hooks.length && !hasNotes) next = "`trod init` sets this repository up; then `trod doctor` again.";
  else if (hasNotes && !linked) next = "`trod notes --link` runs the notes' checks and links them, so sessions load them.";
  else if (!hasNotes && pending > 0) next = claude ? `\`trod learn\` writes notes from your ${pending} session(s) (\`trod learn --dry-run\` shows them first).` : "Install Claude Code, then `trod learn` writes notes from your sessions.";
  else if (!hasNotes) next = "`trod forge --brief @env.md` studies an API, tool or workflow you describe; or work in Claude Code for a while, then `trod learn`.";
  else if (pending >= 5) next = `\`trod learn\` checks the notes against ${pending} new session(s) and adds what they teach.`;
  else next = "Nothing to do. `trod report` shows whether the notes help; `trod verify` in CI catches notes that went stale.";
  return { projectDir: dir, setup, knowledge, sessions, next, broken };
}
var MARK = { ok: "\u2713", info: "\xB7", warn: "!", bad: "\u2717" };
function formatDoctor(r, version) {
  const section = (title, items) => [title, ...items.map((f) => `  ${MARK[f.level]} ${f.text}`)];
  return [`trod ${version} in ${r.projectDir}`, "", ...section("Setup", r.setup), "", ...section("What trod knows here", r.knowledge), "", ...section("Sessions", r.sessions), "", `Next: ${r.next}`].join("\n");
}

// packages/cli/src/help.ts
var OVERVIEW = `trod: teach Claude Code your environment once

A learning session writes verified notes (and tools) about your project; every later session loads them, so a cheap
model works like one that already knows the place.

Usage: trod <command> [options]        trod help <command> for details

Start here
  init         Set this repository up for trod (Claude Code; also --antigravity, --codex)
  doctor       Check the setup, show what trod knows about this project and say what to do next

Learn
  learn        Distil notes from the sessions you already had (--auto <n>: keep doing it by itself)
  forge        Study an API, tool or workflow in a dedicated session: verified tools and notes
  tune         Improve the notes against your own tasks, and keep a rewrite only if it passes more of them

Check
  verify       Re-run every tool example and note check; exit 1 if something went stale (for CI)
  report       Is it helping? Sessions with the notes against sessions without them
  notes        The notes' status; --link them; --delivery hooks|import
  stats        Tool usage from the logs

Tools
  list         List session and library tools
  check        Validate every tool
  promote      Move a session tool into the committed library

Plumbing
  mcp          Start the MCP server on stdio (what MCP clients run)
  hook         The command behind trod's Claude Code hooks

Common options
  --dir <path>   The project (default: TROD_PROJECT_DIR, CLAUDE_PROJECT_DIR, or the nearest folder with .trod/)
  --json         Machine-readable output
  --version      Print trod's version

Docs: https://github.com/swissspidy/trod/blob/main/docs/reference.md`;
var SESSION_OPTIONS = `  --model <id>             The model for the session
  --timeout <minutes>      Stop the session after this long (default 30)
  --budget <usd>           Spend cap for the session (Claude Code's --max-budget-usd)
  --stream <file>          Keep the session's stream-json output in this file
  --no-link                Do not link the notes into CLAUDE.md afterwards`;
var DETAILS = {
  init: `trod init [--vendor] [--allow-exec] [--antigravity | --codex [--auto-approve]]

Sets this repository up for trod in every Claude Code session, local or cloud (also sessions started from the mobile
app): writes .mcp.json, .claude/settings.json (trod's hooks) and the skills. Commit what it writes.

  --vendor        Copy the server into .trod/pkg instead of running it through npx
  --allow-exec    Let tools run (TROD_ALLOW_EXEC=1). Tool code runs outside Claude Code's permission prompts, so
                  this is meant for ephemeral cloud containers
  --antigravity   Set the repository up for Antigravity instead (.agents/mcp_config.json, the skill, and a rule
                  that loads the notes)
  --codex         Set it up for Codex instead (.codex/config.toml, the skills in .agents/skills/, a notes block in
                  AGENTS.md); --auto-approve approves trod's tool calls in Codex (needed for codex exec)`,
  doctor: `trod doctor [--json]

Checks the setup (the Claude Code CLI, the MCP server entry, the hooks, whether tools may run), shows what trod knows
about this project (notes, wiki pages, library, evidence) and how many sessions it has not learned from yet, and
names the next step. Changes nothing and runs no tools. Exits 1 when something is broken.`,
  learn: `trod learn [--from <dir|file>]... [--outcomes <file>] [--limit <n>] [--all] [--brief <text|@file>] [--dry-run]
trod learn --auto <n|off>

Distils notes from sessions that already happened. It condenses Claude Code's transcripts of this project
(~/.claude/projects/<project>/) and Codex's sessions in it (~/.codex/sessions), compares failed with passed sessions
in a learning session and writes rules into .trod/notes.md (and .trod/wiki/ pages when there are many kinds of task).

Incremental: only sessions since the last run (.trod/state/learn.json). With nothing new it exits 0 without starting
a session, so it can run on a schedule. The learner keeps .trod/notes.evidence.json: per rule, how often later
sessions confirmed or contradicted it; rules contradicted more often than confirmed are fixed or dropped.

  --dry-run                Show which sessions it would learn from, and stop (starts no session, costs nothing)
  --from <dir|file>        Transcripts to read instead (repeatable)
  --outcomes <file>        JSON mapping session ids to true/false (e.g. from CI); otherwise the outcome is judged
                           from each transcript
  --limit <n>              At most this many sessions, the most recent first (default 200)
  --all                    Relearn from every session and recount the evidence
  --brief <text|@file>     What the learner should know about the project
  --practice <cmd>         A success check the learner can practise against (see trod help forge)
  --auto <n|off>           Learn by itself: trod's SessionEnd hook starts trod learn in the background once n
                           sessions have ended since the last run (at most once per 6 hours, each run capped at
                           $2; log in .trod/logs/auto-learn.log)
${SESSION_OPTIONS}`,
  forge: `trod forge --brief <text|@file> [--practice <cmd> [--reset <cmd>]]

Runs a dedicated session (headless Claude Code) that studies an environment, builds tools with tested examples and
writes .trod/notes.md. Every valid tool whose examples do not fail is promoted to .trod/library (one without examples
is promoted as unverified); the notes' checks are run, and the notes are linked into CLAUDE.md when they pass.

  --brief <text|@file>     A few lines on the API, tooling or workflow to study (required)
  --practice <cmd>         A shell command whose exit code 0 means the current attempt succeeded (a test suite, a
                           grader). The forge practises against it before writing notes, and its notes are linked
                           only if it passed at least once
  --reset <cmd>            Starts a fresh practice attempt
${SESSION_OPTIONS}`,
  tune: `trod tune [--config <file>] [--iterations <n>] [--runs <n>] [--margin <n>] [--proposer <id>] [--dry-run]

Tunes the notes against your own tasks. List them in .trod/tune.json: {"tasks": [{"id", "prompt", "check"}]}, where
check is a shell command and exit 0 means done. A model (default Haiku) runs the practice tasks, each in a throwaway
copy of the project; a stronger model rewrites .trod/notes.md from the failed sessions; the rewrite replaces the notes
only if it passes at least --margin more held-out validation runs than the current notes.

  --dry-run                Show the split and how many sessions an iteration takes, and stop
  --config <file>          The tasks file (default .trod/tune.json)
  --iterations <n>         Repeat the loop on the winning notes (default 1)
  --runs <n>               Runs per task (default 2)
  --margin <n>             How many more validation runs a rewrite must pass (default 1)
  --model <id>             The model the notes are for (default Haiku)
  --proposer <id>          The model that rewrites the notes (default Opus)
  --parallel <n>           Sessions at a time (default 3)
  --timeout <minutes>      Per task session (default 15)
  --budget <usd>           Spend cap per task session (default 2)`,
  verify: `trod verify [--json]

Re-runs every library tool's examples and every note check against the current environment. Exits 1 if any tool or
note is stale: run it in CI or on a schedule.`,
  report: `trod report [--from <path>...] [--json]

Is trod helping? Compares this project's sessions (Claude Code and Codex transcripts) from before the notes were
linked with those after: turns, tool calls, failed calls, follow-up prompts, tokens, duration; plus the evidence
ledger's summary. With hooks delivery (trod notes --delivery hooks) the comparison is randomized: sessions that got
the notes against a holdout that did not.`,
  notes: `trod notes [--link] [--json]
trod notes --delivery hooks|import [--holdout <share>]

Shows .trod/notes.md's status and runs its checks. --link adds @.trod/notes.md to CLAUDE.md (only when the checks pass).

--delivery chooses how Claude Code sessions get the notes. import (default): the CLAUDE.md import. hooks: trod's hooks
inject the notes at session start and add a .trod/wiki/ page when a prompt matches its "when:" words; a random share
of sessions (--holdout, default 0.1, at most 0.5) gets no notes, so trod report can compare.`,
  stats: `trod stats [--logs <path>] [--json]

Summarizes tool usage across .trod/logs/*.jsonl: tools created, called, reused, errors.`,
  list: `trod list

Lists session tools (.trod/tools) and library tools (.trod/library).`,
  check: `trod check

Validates every tool without running its examples; exits 1 if one is invalid. Single-file tools are imported to read
their meta, which needs TROD_ALLOW_EXEC=1.`,
  promote: `trod promote <name>

Moves .trod/tools/<name> to .trod/library/<name> after its examples pass. Commit the library so later sessions load it.`,
  mcp: `trod mcp

Starts the trod MCP server on stdio, for any MCP client. The project is TROD_PROJECT_DIR, CLAUDE_PROJECT_DIR, the
client's first workspace root, or the working directory.`,
  hook: `trod hook

The command behind trod's Claude Code hooks (JSON on stdin): PostToolUse reports whether a just-written tool is valid,
SessionStart and UserPromptSubmit deliver the notes (hooks delivery), SessionEnd counts sessions for trod learn --auto.`
};
var COMMANDS = Object.keys(DETAILS);
function suggestCommand(input) {
  const distance = (a, b) => {
    const row = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i++) {
      let prev = row[0];
      row[0] = i;
      for (let j = 1; j <= b.length; j++) {
        const cur = row[j];
        row[j] = Math.min(row[j] + 1, row[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1));
        prev = cur;
      }
    }
    return row[b.length];
  };
  const scored = COMMANDS.map((c) => ({ c, d: distance(input.toLowerCase(), c) })).sort((x, y) => x.d - y.d);
  if (scored[0] && scored[0].d <= 2) return scored[0].c;
  return input.length >= 3 ? COMMANDS.find((c) => c.startsWith(input.toLowerCase().slice(0, 3))) : void 0;
}

// packages/cli/src/cli.ts
import { pathToFileURL } from "node:url";
import path9 from "node:path";
import { parseArgs } from "node:util";
import { ANTIGRAVITY_NOTES_RULE as ANTIGRAVITY_NOTES_RULE3, codexNotesFile as codexNotesFile3, linkAntigravityNotes as linkAntigravityNotes3, linkCodexNotes as linkCodexNotes3, computeStats, formatStats, linkNotes as linkNotes2, listToolEntries as listToolEntries2, loadToolEntry, NOTES_IMPORT as NOTES_IMPORT3, NOTES_MAX_CHARS as NOTES_MAX_CHARS4, promoteTool as promoteTool2, readLogs, resolveProjectDir, runToolExamples, trodPaths as trodPaths4, verifyNotes as verifyNotes3, notesPaths as notesPaths3, readTrodConfig as readTrodConfig4, writeTrodConfig as writeTrodConfig2 } from "../server/trod-lib.mjs";
async function main(argv, out = console.log) {
  const { values, positionals } = parseArgs({
    args: argv,
    allowPositionals: true,
    options: {
      dir: { type: "string" },
      logs: { type: "string" },
      json: { type: "boolean", default: false },
      help: { type: "boolean", short: "h", default: false },
      brief: { type: "string" },
      model: { type: "string" },
      server: { type: "string" },
      budget: { type: "string" },
      stream: { type: "string" },
      link: { type: "boolean", default: false },
      delivery: { type: "string" },
      holdout: { type: "string" },
      "no-link": { type: "boolean", default: false },
      practice: { type: "string" },
      reset: { type: "string" },
      from: { type: "string", multiple: true },
      outcomes: { type: "string" },
      limit: { type: "string" },
      all: { type: "boolean", default: false },
      timeout: { type: "string" },
      vendor: { type: "boolean", default: false },
      "allow-exec": { type: "boolean", default: false },
      antigravity: { type: "boolean", default: false },
      codex: { type: "boolean", default: false },
      "auto-approve": { type: "boolean", default: false },
      version: { type: "boolean", short: "v", default: false },
      config: { type: "string" },
      iterations: { type: "string" },
      runs: { type: "string" },
      margin: { type: "string" },
      proposer: { type: "string" },
      parallel: { type: "string" },
      "dry-run": { type: "boolean", default: false },
      auto: { type: "string" }
    }
  });
  const [command, ...rest] = positionals;
  if (values.version) {
    out(packageVersion(defaultPackageRoot()) ?? "dev");
    return 0;
  }
  if (command === "help" || values.help || !command) {
    const topic = command === "help" ? rest[0] : command;
    if (topic && !DETAILS[topic]) {
      const guess = suggestCommand(topic);
      out(`trod: no command "${topic}"${guess ? ` (did you mean "${guess}"?)` : ""}. Run \`trod help\` for the list.`);
      return 1;
    }
    out(topic ? DETAILS[topic] : OVERVIEW);
    return command || values.help ? 0 : 1;
  }
  if (values.link && values["no-link"]) {
    out("trod: --link and --no-link contradict each other");
    return 1;
  }
  if (values.link && command !== "notes" || values["no-link"] && command !== "forge" && command !== "learn") {
    out(`trod ${command}: ${values.link ? "--link only applies to trod notes" : "--no-link only applies to trod forge and trod learn"}`);
    return 1;
  }
  if (values.timeout !== void 0 && !(Number(values.timeout) > 0 && Number(values.timeout) * 6e4 <= 2147483647)) {
    out("trod: --timeout must be a positive number of minutes (at most 35791)");
    return 1;
  }
  const paths = trodPaths4(values.dir ? path9.resolve(values.dir) : resolveProjectDir());
  switch (command) {
    case "mcp": {
      await import(pathToFileURL(values.server ?? defaultServerPath()).href);
      return new Promise(() => {
      });
    }
    case "init": {
      let res;
      try {
        res = init({ projectDir: paths.projectDir, vendor: values.vendor, allowExec: values["allow-exec"], antigravity: values.antigravity, codex: values.codex, autoApprove: values["auto-approve"] });
      } catch (err) {
        out(err.message);
        return 1;
      }
      for (const f of res.written) out(`wrote     ${f}`);
      for (const f of res.unchanged) out(`unchanged ${f}`);
      for (const n of res.notes) out(n);
      out(values.antigravity ? "Commit these files. Antigravity starts trod from .agents/mcp_config.json in this workspace." : values.codex ? "Commit these files. Codex starts trod from .codex/config.toml once you trust the project." : "Commit these files. Local sessions and cloud sessions (also from the mobile app) start trod from .mcp.json.");
      out("Next: `trod doctor` shows the setup and what to do next (`trod learn` once you have a few sessions, or `trod forge` to study something now).");
      return 0;
    }
    case "doctor": {
      const report = doctor(paths);
      out(values.json ? JSON.stringify(report, null, 2) : formatDoctor(report, packageVersion(defaultPackageRoot()) ?? "dev"));
      return report.broken ? 1 : 0;
    }
    case "promote": {
      const name = rest[0];
      if (!name) {
        out("trod promote: missing tool name");
        return 1;
      }
      const res = await promoteTool2(paths, name);
      out(`promoted ${name} -> ${path9.relative(paths.projectDir, res.to)}${res.replaced ? " (replaced the previous library version)" : ""}${res.examplesPassed ? `, ${res.examplesPassed} example(s) passed` : ""}`);
      out("Commit .trod/library/ so later sessions load it.");
      return 0;
    }
    case "report": {
      const sources = values.from?.length ? values.from.map((f) => path9.resolve(f)) : [transcriptDir(paths.projectDir), ...codexTranscripts(paths.projectDir)];
      const sessions = findTranscripts(sources).map((f) => sessionMetrics(f)).filter((m) => m !== void 0);
      const delivery = sessionDelivery(paths);
      const logged = sessions.filter((s) => delivery.has(s.id));
      const report = logged.length && logged.some((s) => delivery.get(s.id)?.holdout) ? buildHoldoutReport(sessions, delivery) : buildReport(sessions, notesSince(paths.projectDir));
      const ledger = readLedger(paths.projectDir);
      if (values.json) out(JSON.stringify({ ...report, evidence: ledger.exists ? ledger.rules : void 0 }, null, 2));
      else out(formatReport(report, ledger.exists && ledger.rules.length ? summarizeLedger(ledger.rules) : void 0));
      return 0;
    }
    case "stats": {
      const stats = computeStats(readLogs(values.logs ? path9.resolve(values.logs) : paths.logsDir));
      out(values.json ? JSON.stringify(stats, null, 2) : formatStats(stats));
      return 0;
    }
    case "check":
    case "list": {
      let bad = 0;
      const execAllowed = process.env.TROD_ALLOW_EXEC === "1";
      for (const [source, root] of [["library", paths.libraryDir], ["session", paths.toolsDir]]) {
        for (const entry of listToolEntries2(root)) {
          const t = await loadToolEntry(entry, source, { execAllowed });
          if (!t.ok) bad++;
          out(`${t.ok ? "ok     " : "INVALID"} ${source}/${t.folder}${t.ok || command === "list" ? "" : "\n  - " + t.errors.join("\n  - ")}`);
        }
      }
      return command === "check" && bad ? 1 : 0;
    }
    case "forge": {
      if (!values.brief) {
        out("trod forge: --brief is required (text, or @path/to/brief.md)");
        return 1;
      }
      const brief = values.brief.startsWith("@") ? readFileSync9(values.brief.slice(1), "utf8") : values.brief;
      if (values.reset && !values.practice) {
        out("trod forge: --reset needs --practice");
        return 1;
      }
      const practice = values.practice ? { check: values.practice, reset: values.reset } : void 0;
      const res = await forge({ projectDir: paths.projectDir, brief, model: values.model, server: values.server, maxBudgetUsd: values.budget, timeoutMs: values.timeout ? Number(values.timeout) * 6e4 : void 0, streamFile: values.stream, out, linkNotes: !values["no-link"], practice });
      return forgeExit("forge", res, values.json, out);
    }
    case "tune": {
      const file = values.config ? path9.resolve(values.config) : path9.join(paths.projectDir, TUNE_CONFIG);
      let config;
      try {
        config = readTuneConfig(file);
        for (const k of ["iterations", "runs", "margin", "parallel"]) {
          if (values[k] === void 0) continue;
          const n = Number(values[k]);
          if (!Number.isInteger(n) || n < (k === "margin" ? 0 : 1)) throw new Error(`--${k} must be a whole number${k === "margin" ? "" : " \u2265 1"}`);
          config[k] = n;
        }
        if (values.model) config.model = values.model;
        if (values.proposer) config.proposer = values.proposer;
        if (values.budget) config.maxBudgetUsd = values.budget;
        if (values.timeout) config.timeoutMinutes = Math.ceil(Number(values.timeout));
        const { practice, validate } = splitTasks(config.tasks);
        if (values["dry-run"]) {
          const runs = config.runs ?? 2;
          out(`practice (${practice.length}): ${practice.map((t) => t.id).join(", ")}`);
          out(`validate (${validate.length}): ${validate.map((t) => t.id).join(", ")}`);
          out(`per iteration: ${practice.length * runs} practice run(s), 1 proposer session, ${2 * validate.length * runs} validation run(s); model ${config.model ?? DEFAULT_TUNE_MODEL}, proposer ${config.proposer ?? DEFAULT_TUNE_PROPOSER}`);
          return 0;
        }
      } catch (e) {
        out(`trod tune: ${e.message}`);
        return 1;
      }
      const res = await tune({ projectDir: paths.projectDir, config, out, configFile: file });
      if (values.json) out(JSON.stringify(res, null, 2));
      return res.iterations.some((it) => it.practice.runs > it.practice.errors) ? 0 : 1;
    }
    case "learn": {
      if (values.auto !== void 0) {
        const r = setAutoLearn(paths, values.auto);
        out(r.ok ? r.message : `trod learn: ${r.message}`);
        return r.ok ? 0 : 1;
      }
      if (values.reset && !values.practice) {
        out("trod learn: --reset needs --practice");
        return 1;
      }
      const sources = values.from?.length ? values.from.map((f) => path9.resolve(f)) : [transcriptDir(paths.projectDir), ...codexTranscripts(paths.projectDir)];
      const outcomes = values.outcomes ? readOutcomes(values.outcomes) : void 0;
      const limit = values.limit ? Number(values.limit) : 200;
      if (!Number.isInteger(limit) || limit < 1) {
        out("trod learn: --limit must be a positive integer");
        return 1;
      }
      const release = acquireLearnLock(paths.projectDir);
      if (!release) {
        out("learn: another trod learn run is in progress for this project; nothing to do");
        return 0;
      }
      let digestsDir;
      try {
        const files = findTranscripts(sources);
        const state = readLearnState(paths.projectDir);
        const { picked, skipped } = pickSessions(files, { seen: new Set(values.all ? [] : state.sessions), limit, outcomes });
        if (!picked.length) {
          if (!files.length && values.from?.length) {
            out(`trod learn: no session transcripts found in ${sources.join(", ")}`);
            return 1;
          }
          if (values["dry-run"]) {
            out(skipped ? `learn: nothing new since the last run (${skipped} session(s) already learned from)` : "learn: no sessions of this project to learn from yet");
            return 0;
          }
          out(skipped ? `learn: nothing new since the last run (${state.lastRun ?? "unknown"}; ${skipped} session(s) already learned from). --all learns from them again.` : `learn: nothing to learn from yet (no sessions of this project in ${values.from?.length ? sources.join(", ") : `${transcriptDir(paths.projectDir)} or ${codexSessionsDir()}`})`);
          return 0;
        }
        if (values["dry-run"]) {
          const by = (o) => picked.filter((d) => d.outcome === o).length;
          out(`learn would read ${picked.length} session(s)${files.length > picked.length && picked.length === limit ? ` (the ${limit} most recent)` : ""}: ${by("pass")} passed, ${by("fail")} failed, ${by("unknown")} with an outcome to judge from the transcript${skipped ? `; ${skipped} already learned from` : ""}`);
          for (const d of picked.slice(0, 15)) out(`  ${d.outcome.padEnd(7)} ${String(d.toolCalls).padStart(3)} tool calls, ${d.errors} errors  ${(d.task.split("\n").find((l) => /\w/.test(l)) ?? "").trim().slice(0, 90)}`);
          if (picked.length > 15) out(`  \u2026 and ${picked.length - 15} more`);
          out("Nothing was started. Run `trod learn` to learn from them (one session; cap its spend with --budget <usd>).");
          return 0;
        }
        const delivery = sessionDelivery(paths);
        for (const d of picked) {
          const had = delivery.get(d.id);
          if (had) d.text = d.text.replace(/^(# Session [^\n]*\n)/, `$1
Notes: ${had.holdout ? "HOLDOUT (this session ran without notes or wiki pages)" : `${had.notes ? ".trod/notes.md loaded" : ".trod/notes.md not delivered (none yet)"}${had.pages.length ? `; wiki pages added: ${had.pages.join(", ")}` : ""}`}
`);
        }
        digestsDir = mkdtempSync3(path9.join(tmpdir3(), "trod-learn-"));
        const dir = digestsDir;
        const counts = writeDigests(path9.join(dir, "sessions"), picked);
        out(`learning from ${picked.length} session(s) (${counts.pass} passed, ${counts.fail} failed, ${counts.unknown} unknown)${files.length > picked.length && picked.length === limit ? `, the ${limit} most recent` : ""}`);
        let brief = values.brief ? values.brief.startsWith("@") ? readFileSync9(values.brief.slice(1), "utf8") : values.brief : "No brief: learn from the sessions and the project's files.";
        if (!execEnabled(paths.projectDir)) brief += "\n\nSessions in this project cannot run trod tools (execution is off), so do not build tools and do not refer to any in the notes: put everything a session needs into the notes themselves.";
        const practice = values.practice ? { check: values.practice, reset: values.reset } : void 0;
        const before = snapshot(paths.projectDir);
        const ledgerBefore = readLedger(paths.projectDir).rules;
        const res = await forge({ projectDir: paths.projectDir, brief, model: values.model, server: values.server, maxBudgetUsd: values.budget, timeoutMs: values.timeout ? Number(values.timeout) * 6e4 : void 0, streamFile: values.stream, out, linkNotes: !values["no-link"], practice, activity: `learning from ${picked.length} session(s)`, notesBasis: "they rest on the sessions they were learned from", prompt: LEARN_PROMPT(path9.join(dir, "sessions"), counts, values.all ? void 0 : state, values.all) });
        if (!res.promoted.length && snapshot(paths.projectDir) === before) {
          out("learn: the learner changed nothing in .trod/notes.md, .trod/wiki/ or the evidence ledger");
          forgeExit("learn", res, values.json, out);
          return 1;
        }
        const ledger = readLedger(paths.projectDir);
        const ledgerErrors = ledger.exists ? [...ledger.errors, ...checkLedgerHistory(ledgerBefore, ledger.rules, values.all)] : [`${LEDGER_FILE} is missing: the learner must keep the evidence ledger`];
        if (ledger.exists) out(`  evidence: ${summarizeLedger(ledger.rules)}`);
        for (const e of ledgerErrors) out(`  ${e}`);
        const code = forgeExit("learn", res, values.json, out);
        if (ledgerErrors.length) {
          out("learn: sessions not marked as learned (the evidence ledger needs fixing); the next run retries them");
          return 1;
        }
        if (res.exitCode === 0) writeLearnState(paths.projectDir, picked.map((d) => d.id));
        return code;
      } finally {
        if (digestsDir) rmSync3(digestsDir, { recursive: true, force: true });
        release();
      }
    }
    case "verify": {
      const report = [];
      for (const entry of listToolEntries2(paths.libraryDir)) {
        const t = await loadToolEntry(entry, "library", { execAllowed: true });
        if (t.ok) await runToolExamples(t, { projectDir: paths.projectDir, execAllowed: true });
        const examples = t.examples ? t.examples.passed + t.examples.failed : 0;
        report.push({ tool: t.folder, ok: t.ok, examples, errors: t.errors });
        if (!values.json) out(`${t.ok ? examples ? "ok     " : "ok (no examples)" : "STALE  "} ${t.folder}${t.ok ? "" : "\n  - " + t.errors.join("\n  - ")}`);
      }
      const stale = report.filter((r) => !r.ok);
      const verified = report.filter((r) => r.ok && r.examples > 0).length;
      const unverifiable = report.filter((r) => r.ok && r.examples === 0).length;
      const notes = await verifyNotes3(paths, { execAllowed: true });
      const staleNotes = notes.checks.filter((c) => !c.ok);
      if (values.json) out(JSON.stringify({ stale: stale.map((r) => r.tool), unverifiable, tools: report, notes }, null, 2));
      else {
        out(`${verified}/${report.length} library tool(s) verified${unverifiable ? `, ${unverifiable} without examples (cannot be verified)` : ""}${stale.length ? `; stale: ${stale.map((r) => r.tool).join(", ")} (re-forge or fix them)` : ""}`);
        if (notes.exists || notes.checks.length) printNotes(notes, out);
      }
      return stale.length || staleNotes.length || notes.errors.length ? 1 : 0;
    }
    case "notes": {
      if (values.delivery !== void 0) return await setDelivery(paths, values.delivery, values.holdout, out);
      let notes = await verifyNotes3(paths, { execAllowed: true });
      const failed = notes.checks.some((c) => !c.ok) || notes.errors.length > 0;
      if (values.link) {
        if (!notes.exists) out("trod notes --link: no .trod/notes.md to link");
        else if (failed) out("trod notes --link: not linked, some checks fail (fix or remove those claims and their checks first)");
        else {
          if (linkNotes2(paths)) {
            out(`linked .trod/notes.md into CLAUDE.md (${NOTES_IMPORT3})`);
            notes = { ...notes, linked: true };
          }
          const rule = linkAntigravityNotes3(paths);
          if (rule === "written") out(`linked .trod/notes.md into Antigravity (${ANTIGRAVITY_NOTES_RULE3})`);
          else if (typeof rule === "object") out(rule.error);
          const codex = linkCodexNotes3(paths);
          if (codex === "written") out(`linked .trod/notes.md into Codex (${codexNotesFile3(paths)})`);
          else if (typeof codex === "object") out(codex.error);
        }
      }
      if (values.json) out(JSON.stringify(notes, null, 2));
      else if (!notes.exists) out("no .trod/notes.md (trod forge writes one)");
      else printNotes(notes, out);
      return failed || values.link && !notes.exists ? 1 : 0;
    }
    case "hook": {
      const raw = await readStdin();
      let payload = {};
      try {
        payload = JSON.parse(raw);
      } catch {
      }
      const event = payload.hook_event_name ?? "PostToolUse";
      if (event === "SessionEnd") {
        try {
          sessionEndHook(values.dir ? paths : trodPaths4(resolveProjectDir(process.env, payload.cwd ?? process.cwd())), payload);
        } catch (err) {
          process.stderr.write(`trod hook: ${err.message}
`);
        }
        return 0;
      }
      if (event === "SessionStart" || event === "UserPromptSubmit") {
        const hookPaths = values.dir ? paths : trodPaths4(resolveProjectDir(process.env, payload.cwd ?? process.cwd()));
        let context;
        try {
          context = notesHook(hookPaths, payload);
        } catch (err) {
          process.stderr.write(`trod hook: ${err.message}
`);
        }
        if (context) out(JSON.stringify({ hookSpecificOutput: { hookEventName: event, additionalContext: context } }));
        return 0;
      }
      const msg = await hookMessage(raw);
      if (msg) out(JSON.stringify({ hookSpecificOutput: { hookEventName: "PostToolUse", additionalContext: msg } }));
      return 0;
    }
    default: {
      const guess = suggestCommand(command);
      out(`trod: unknown command "${command}"${guess ? ` (did you mean "${guess}"?)` : ""}. Run \`trod help\` for the list.`);
      return 1;
    }
  }
}
function snapshot(projectDir) {
  const read = (f) => existsSync8(f) ? readFileSync9(f, "utf8") : "";
  const wiki = path9.join(projectDir, ".trod", "wiki");
  const pages = existsSync8(wiki) ? readdirSync5(wiki).sort().map((f) => `${f}
${read(path9.join(wiki, f))}`) : [];
  return [read(path9.join(projectDir, ".trod", "notes.md")), read(path9.join(projectDir, LEDGER_FILE)), ...pages].join("\n\0");
}
function forgeExit(command, res, json, out) {
  out(`${command}: ${res.promoted.length} tool(s) promoted${res.unverified.length ? ` (${res.unverified.length} without examples)` : ""}, ${res.rejected.length} rejected${res.notes ? `, notes ${res.notes.linked ? "linked" : "not linked"}` : ", no notes"}${res.costUsd !== void 0 ? `, $${res.costUsd.toFixed(3)}, ${res.turns} turns` : ""}`);
  if (json) out(JSON.stringify(res, null, 2));
  const notesFailed = !!res.notes && (res.notes.checks.some((c) => !c.ok) || res.notes.errors.length > 0);
  const notesVerified = !!res.notes && !notesFailed && (command === "learn" || res.notes.checks.length > 0 || (res.practice?.passed ?? 0) > 0);
  const ok = !!(res.promoted.length || notesVerified) && !notesFailed && res.exitCode === 0;
  if (ok && !json) out(`Next: review what changed under .trod/ (and CLAUDE.md) with \`git diff\`, then commit it. Sessions started after that load the notes${res.promoted.length ? " and the library" : ""}.`);
  return ok ? 0 : 1;
}
async function setDelivery(paths, delivery, holdout, out) {
  if (delivery !== "hooks" && delivery !== "import") {
    out("trod notes: --delivery must be hooks or import");
    return 1;
  }
  const config = readTrodConfig4(paths);
  const share = holdout === void 0 ? config.holdout ?? 0.1 : Number(holdout);
  if (!(share >= 0 && share <= 0.5)) {
    out("trod notes: --holdout must be a share between 0 and 0.5");
    return 1;
  }
  const notes = await verifyNotes3(paths, { execAllowed: true });
  const failing = notes.exists && (notes.checks.some((c) => !c.ok) || notes.errors.length > 0);
  if (failing && delivery === "hooks") {
    printNotes(notes, out);
    out("trod notes: delivery not changed, some checks fail (fix or remove those claims and their checks first)");
    return 1;
  }
  const { claudeMd } = notesPaths3(paths);
  if (delivery === "hooks") {
    const hookCommand = deliveryHookCommand(paths.projectDir);
    if ("error" in hookCommand) {
      out(`trod notes: ${hookCommand.error}`);
      return 1;
    }
    const res = { written: [], unchanged: [], notes: [] };
    try {
      installClaudeHooks(paths.projectDir, hookCommand.command, res);
    } catch (e) {
      out(`trod notes: could not install the hooks in .claude/settings.json (${e.message}); delivery not changed`);
      return 1;
    }
    for (const f of res.written) out(`wrote     ${f}`);
    writeTrodConfig2(paths, { ...config, delivery: "hooks", holdout: share });
    if (removeNotesImport(claudeMd)) out(`removed ${NOTES_IMPORT3} from CLAUDE.md`);
    out(`notes now reach Claude Code sessions through trod's hooks; ${Math.round(share * 100)}% of sessions are a holdout without notes (trod report compares the two). Commit .trod/config.json and .claude/settings.json.`);
    return 0;
  }
  const { delivery: _, ...rest } = config;
  writeTrodConfig2(paths, rest);
  if (failing) {
    if (removeNotesImport(claudeMd)) out(`removed ${NOTES_IMPORT3} from CLAUDE.md`);
    printNotes(notes, out);
    out("hooks delivery is off; the notes are not linked into CLAUDE.md while checks fail (fix them, then trod notes --link)");
    return 1;
  }
  if (linkNotes2(paths)) out(`linked .trod/notes.md into CLAUDE.md (${NOTES_IMPORT3})`);
  out("notes reach Claude Code sessions through the CLAUDE.md import again (the hooks stay installed and do nothing).");
  return 0;
}
function removeNotesImport(claudeMd) {
  if (!existsSync8(claudeMd)) return false;
  const text = readFileSync9(claudeMd, "utf8");
  const next = text.replace(/\n?## Project notes \(trod\)\n\nVerified notes about this project's environment, kept by trod[^\n]*\n\n[ \t]*@\.trod\/notes\.md[ \t]*\n?/, "\n").replace(/^[ \t]*@\.trod\/notes\.md[ \t]*(\r?\n|$)/gm, "");
  if (next === text) return false;
  writeFileSync7(claudeMd, next.replace(/\n{3,}/g, "\n\n"));
  return true;
}
function deliveryHookCommand(dir) {
  const version = packageVersion(defaultPackageRoot());
  const current = `npx -y ${version ? `trod@${version}` : "trod"} hook`;
  const installed = installedHookCommand(dir);
  if (!installed) return { command: current };
  if (/^npx -y trod(@\S+)? hook$/.test(installed.trim())) return { command: installed.trim() === "npx -y trod hook" ? installed.trim() : current };
  if (installed.includes(".trod/pkg/bin/trod")) {
    const vendored = packageVersion(path9.join(dir, ".trod", "pkg"));
    if (version && vendored !== version) return { error: `the vendored trod in .trod/pkg is ${vendored ?? "unknown"}, older than ${version}: re-run \`trod init --vendor\` first, so its hook handles notes delivery` };
  }
  return { command: installed };
}
async function readStdin() {
  let raw = "";
  for await (const chunk of process.stdin) raw += chunk;
  return raw;
}
async function hookMessage(raw, env = process.env) {
  let payload;
  try {
    payload = JSON.parse(raw);
  } catch {
    return void 0;
  }
  const file = payload.tool_input?.file_path;
  if (!file) return void 0;
  const m = file.match(/^(.*)[\\/]\.trod[\\/](tools|library)[\\/]([^\\/]+)/);
  if (!m) return void 0;
  const [, projectDir, kind, first] = m;
  const source = kind === "library" ? "library" : "session";
  const entry = path9.join(projectDir, ".trod", kind, first);
  let isDir = false;
  try {
    isDir = statSync3(entry).isDirectory();
  } catch {
  }
  if (first.startsWith(".") || !isDir && !first.endsWith(".mjs")) return void 0;
  const execAllowed = env.TROD_ALLOW_EXEC === "1";
  const tool = await loadToolEntry(entry, source, { execAllowed, env });
  if (tool.ok) await runToolExamples(tool, { projectDir, execAllowed, env });
  const name = tool.folder;
  if (!tool.ok) {
    return `trod: tool "${name}" is NOT registered:
- ${tool.errors.join("\n- ")}
Fix the file; trod re-validates on every change.`;
  }
  const ex = tool.examples && !tool.examples.skipped ? ` Examples: ${tool.examples.passed} passed.` : "";
  const exec = execAllowed ? "" : " Note: execution is disabled (TROD_ALLOW_EXEC is not 1), so calls will be refused.";
  return `trod: tool "${name}" is valid and live. Call it now with trod_run {"tool": "${name}", "input": {\u2026}}, no loading needed (it is also registered as the MCP tool ${name}); no need to call trod_status.${ex}${exec}`;
}
function printNotes(notes, out) {
  const passed2 = notes.checks.filter((c) => c.ok).length;
  out(`notes: ${notes.exists ? `${notes.chars} chars` : "missing"}${notes.tooLong ? ` (over ${NOTES_MAX_CHARS4}: they are in every session's context, trim them)` : ""}, ${passed2}/${notes.checks.length} check(s) passed, ${notes.linked ? notes.delivery === "hooks" ? "delivered by trod's hooks" : "linked from CLAUDE.md" : `not linked (trod notes --link adds ${NOTES_IMPORT3} to CLAUDE.md)`}`);
  for (const c of notes.checks.filter((c2) => !c2.ok)) out(`  STALE  "${c.claim}" (${c.tool}): ${c.error}`);
  for (const e of notes.errors) out(`  ${e}`);
}

// packages/cli/src/bin.ts
main(process.argv.slice(2)).then(
  (code) => process.exit(code),
  (err) => {
    console.error(`trod: ${err.message}`);
    process.exit(1);
  }
);
